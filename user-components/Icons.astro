---
type IconName =
  | 'play'
  | 'pause'
  | 'arrow-left'
  | 'arrow-right'
  | 'chevron-down'
  | 'download'
  | 'search'
  | 'menu'
  | 'close'
  | 'external'
  | 'star'
  | 'tv'
  | 'list'
  | 'book'
  | 'rss';

interface Props {
  name: IconName;
  size?: number;
}

const { name, size = 16 } = Astro.props;

const paths: Record<IconName, string> = {
  'play':         '<path d="M3 2l10 6-10 6V2z" fill="currentColor" stroke="none" />',
  'pause':        '<path d="M4 3v10M12 3v10" />',
  'arrow-left':   '<path d="M13 8H3M7 4L3 8l4 4" />',
  'arrow-right':  '<path d="M3 8h10M9 4l4 4-4 4" />',
  'chevron-down': '<path d="M4 6l4 4 4-4" />',
  'download':     '<path d="M8 2v8M4 7l4 4 4-4M3 14h10" />',
  'search':       '<circle cx="7" cy="7" r="4" /><path d="M14 14l-3.5-3.5" />',
  'menu':         '<path d="M2 4h12M2 8h12M2 12h12" />',
  'close':        '<path d="M3 3l10 10M13 3L3 13" />',
  'external':     '<path d="M6 4h6v6M12 4L5 11M4 6v6h6" />',
  'star':         '<path d="M8 2l1.8 4.2L14 7l-3 3 .8 4.5L8 12.4l-3.8 2.1L5 10 2 7l4.2-.8z" fill="currentColor" stroke="none" />',
  'tv':           '<rect x="2" y="4" width="12" height="9" /><path d="M6 14h4" />',
  'list':         '<path d="M3 4h10M3 8h10M3 12h10" />',
  'book': '<path d="M3 3h4a2 2 0 0 1 2 2v8a2 2 0 0 0-2-2H3V3zM13 3H9a2 2 0 0 0-2 2v8a2 2 0 0 1 2-2h4V3z" />',
  'rss': '<circle cx="4" cy="12" r="1.75" fill="currentColor" stroke="none" /><path d="M3 7a6 6 0 0 1 6 6M3 3a10 10 0 0 1 10 10" />',
};
---

<svg
  width={size}
  height={size}
  viewBox="0 0 16 16"
  fill="none"
  stroke="currentColor"
  stroke-width="1.75"
  stroke-linecap="square"
  stroke-linejoin="miter"
  aria-hidden="true"
  set:html={paths[name]}
/>