---
import { getCollection } from 'astro:content';
import { SITE, GENRES, PER_PAGE, URLS } from '~/constants';
import { sortByRecent } from '~/lib/anime';

import BaseLayout from '~/layouts/BaseLayout.astro';
import AnimeCard from '~/components/AnimeCard.astro';
import Badge from '~/user-components/Badge.astro';
import LinkButton from '~/user-components/LinkButton.astro';
import LinkCard from '~/user-components/LinkCard.astro';
import SectionLabel from '~/components/SectionLabel.astro';

const allAnime = await getCollection('anime');

const latest = sortByRecent(allAnime).slice(0, 3);

const ongoing = sortByRecent(
  allAnime.filter(a => a.data.status === 'Ongoing')
).slice(0, PER_PAGE - 1);

const completed = sortByRecent(
  allAnime.filter(a => a.data.status === 'Completed')
).slice(0, PER_PAGE - 1);

const genreCounts: Record<string, number> = {};
allAnime.forEach(a => {
  a.data.genre.forEach(g => {
    genreCounts[g] = (genreCounts[g] || 0) + 1;
  });
});
const genres = GENRES
  .map(name => ({ name, count: genreCounts[name] || 0 }))
  .filter(g => g.count > 0)
  .sort((a, b) => b.count - a.count)
  .slice(0, 8);
---

<BaseLayout title={SITE.title}>
  <div class="wrapper">
    {latest.length > 0 && (
      <section class="hero-carousel" aria-label="Anime terbaru">
        <div class="hero-track">
          {latest.map((anime, i) => (
            <article class="hero-slide" id={`slide-${i + 1}`}>
              <div class="hero-slide-inner">
                <div class="hero-text">
                  <Badge variant="accent" mark>BARU</Badge>
                  <h1 class="hero-title">{anime.data.title}</h1>
                  <p class="hero-meta">
                    {anime.data.status} · {anime.data.releaseDate.getFullYear()} · Rating {anime.data.rating}
                  </p>
                  <LinkButton
                    href={URLS.anime(anime.id)}
                    variant="accent"
                    size="lg"
                    icon="play"
                  >
                    Tonton
                  </LinkButton>
                </div>
                <div class="hero-cover">
                  <img
                    src={anime.data.cover}
                    alt={`Cover ${anime.data.title}`}
                    width="300"
                    height="450"
                    loading={i === 0 ? 'eager' : 'lazy'}
                    fetchpriority={i === 0 ? 'high' : 'auto'}
                    decoding="async"
                  />
                </div>
              </div>
            </article>
          ))}
        </div>

        <nav class="hero-dots" aria-label="Navigasi slide">
          {latest.map((_, i) => (
            <button
              type="button"
              class:list={['hero-dot', { active: i === 0 }]}
              data-index={i}
              aria-label={`Slide ${i + 1}`}
            ></button>
          ))}
        </nav>
      </section>
    )}

    {ongoing.length > 0 && (
      <section class="landing-section">
        <header class="section-header">
          <SectionLabel>Ongoing</SectionLabel>
          <LinkButton
            href={URLS.status('Ongoing')}
            variant="ghost"
            size="md"
            icon="arrow-right"
            iconPos="suffix"
          >
            Lihat Semua
          </LinkButton>
        </header>
        <div class="anime-grid">
          {ongoing.map(anime => <AnimeCard anime={anime} />)}
        </div>
      </section>
    )}

    {completed.length > 0 && (
      <section class="landing-section">
        <header class="section-header">
          <SectionLabel>Completed</SectionLabel>
          <LinkButton
            href={URLS.status('Completed')}
            variant="ghost"
            size="md"
            icon="arrow-right"
            iconPos="suffix"
          >
            Lihat Semua
          </LinkButton>
        </header>
        <div class="anime-grid">
          {completed.map(anime => <AnimeCard anime={anime} />)}
        </div>
      </section>
    )}

    {genres.length > 0 && (
      <section class="landing-section">
        <header class="section-header">
          <SectionLabel>Genre</SectionLabel>
          <LinkButton
            href="/genre/"
            variant="ghost"
            size="md"
            icon="arrow-right"
            iconPos="suffix"
          >
            Lihat Semua
          </LinkButton>
        </header>
        <div class="genre-grid">
          {genres.map(g => (
            <LinkCard
              href={URLS.genre(g.name)}
              variant="outline"
              padding="sm"
            >
              <span class="genre-name">{g.name}</span>
            </LinkCard>
          ))}
        </div>
      </section>
    )}

  </div>
</BaseLayout>

<script>
  const track = document.querySelector<HTMLElement>('.hero-track');
  const dots = document.querySelectorAll<HTMLButtonElement>('.hero-dot');

  if (track && dots.length > 0) {
    const slides = track.querySelectorAll<HTMLElement>('.hero-slide');

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const index = Array.from(slides).indexOf(entry.target as HTMLElement);
            dots.forEach((dot, i) => {
              dot.classList.toggle('active', i === index);
            });
          }
        });
      },
      { root: track, threshold: 0.6 }
    );

    slides.forEach((slide) => observer.observe(slide));

    dots.forEach((dot) => {
      dot.addEventListener('click', () => {
        const index = Number(dot.dataset.index);
        const target = slides[index];
        if (!target) return;

        track.scrollTo({
          left: target.offsetLeft,
          behavior: 'smooth',
        });
      });
    });
  }
</script>

<style>
  .wrapper {
    padding-block: var(--s-6) var(--s-12);
    display: flex;
    flex-direction: column;
    gap: var(--s-10);
  }

  .hero-carousel {
    margin-inline: calc(50% - 50vw);
    margin-block-start: calc(var(--s-6) * -1);
  }

  .hero-track {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    background: var(--bg-footer);
    border-block-end: 1px solid var(--border);
    scrollbar-width: none;
  }

  .hero-track::-webkit-scrollbar {
    display: none;
  }

  .hero-slide {
    flex: 0 0 100%;
    scroll-snap-align: start;
  }

  .hero-slide-inner {
    max-width: var(--content-max-mobile);
    margin-inline: auto;
    padding: var(--s-5) var(--pad-x);
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s-4);
    align-items: center;
  }

  .hero-cover {
    order: -1;
    width: 100%;
    max-width: 200px;
    margin-inline: auto;
  }

  .hero-cover img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
    aspect-ratio: 2 / 3;
    image-rendering: -webkit-optimize-contrast;
  }

  .hero-text {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    text-align: center;
    align-items: center;
  }

  .hero-title {
    font-size: var(--fs-4xl);
    margin: 0;
    color: var(--text-inverted);
    line-height: var(--lh-tight);
    font-weight: 600;
  }

  .hero-meta {
    color: var(--text-inverted);
    opacity: 0.75;
    font-size: var(--fs-base);
    line-height: var(--lh-relaxed);
    margin: 0;
  }

  .hero-dots {
    display: flex;
    justify-content: center;
    gap: var(--s-2);
    margin-top: var(--s-4);
  }

  .hero-dot {
    width: 8px;
    height: 8px;
    padding: 0;
    border: none;
    background: var(--border);
    cursor: pointer;
    transition: background var(--t-fast), transform var(--t-fast);
  }

  .hero-dot:hover {
    background: var(--border-hover);
  }

  .hero-dot.active {
    background: var(--accent);
    transform: scale(1.3);
  }

  .landing-section {
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
  }

  .section-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
  }

  /* .section-title DIHAPUS — sudah pakai SectionLabel component */

  .anime-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-3);
  }

  .genre-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-3);
  }

  .genre-name {
    font-weight: var(--fw-semibold);
    color: var(--text-primary);
  }

  @media (min-width: 50rem) {
    .hero-slide-inner {
      max-width: var(--content-max-desktop);
      grid-template-columns: 1.2fr 1fr;
      gap: var(--s-8);
      padding: var(--s-8) var(--pad-x);
      min-height: 320px;
    }

    .hero-cover {
      order: 0;
      width: auto;
      max-width: none;
      justify-self: end;
      margin-inline: 0;
    }

    .hero-cover img {
      max-height: 280px;
      width: auto;
    }

    .genre-grid {
      grid-template-columns: repeat(6, minmax(0, 1fr));
      gap: var(--s-4);
    }

    .hero-text {
      text-align: left;
      align-items: flex-start;
    }

    .hero-title {
      font-size: var(--fs-6xl);
    }

    .anime-grid {
      grid-template-columns: repeat(6, minmax(0, 1fr));
      gap: var(--s-4);
    }
  }
</style>