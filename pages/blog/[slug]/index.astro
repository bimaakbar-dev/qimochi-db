---
import { render } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import PostCard from '~/components/PostCard.astro';
import Badge from '~/user-components/Badge.astro';
import Icon from '~/user-components/Icons.astro';
import {
  getPublishedPostBySlug,
  getAllPostSlugs,
  getPublishedPosts,
  getRelatedPosts,
  formatDate,
} from '~/lib/blog';

export async function getStaticPaths() {
  const slugs = await getAllPostSlugs();
  return slugs.map(slug => ({
    params: { slug },
  }));
}

const { slug } = Astro.params;
const post = await getPublishedPostBySlug(slug!);

if (!post) {
  return Astro.redirect('/404');
}

const { data } = post;
const { Content } = await render(post);

const dateText = formatDate(data.date);
const updatedText = data.updatedAt ? formatDate(data.updatedAt) : null;

const allPosts = await getPublishedPosts();
const related = getRelatedPosts(post, allPosts, 3);
---

<BaseLayout
  title={data.title}
  description={data.description}
  image={data.cover}
  type="article"
  publishedTime={data.date.toISOString()}
  canonical={`/blog/${post.id}/`}
>
  <div class="wrapper">
    <article>
      <header>
        <Badge variant="accent" size="sm">{data.category}</Badge>
        <h1 set:html={data.title} />
        <div class="post-meta">
          <span class="post-icon" aria-hidden="true">
            <Icon name="book" size={24} />
          </span>
          <p class="post-author">Oleh {data.author}</p>
          <p class="post-date">
            <time datetime={data.date.toISOString()}>{dateText}</time>
          </p>
        </div>
      </header>
      {data.cover && (
        <div class="cover">
          <img
            src={data.cover}
            alt={`Cover ${data.title}`}
            width="1200"
            height="675"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </div>
      )}

      <div class="markdown markdown--prose post-body">
        <Content />
      </div>

      {data.tags.length > 0 && (
        <footer class="post-footer">
          <p class="update">
            {updatedText && (
              <time datetime={data.date.toISOString()}> Diperbarui {updatedText}</time>
            )}
          </p>
          <div class="post-tags">
            <span class="tags-label">Tags:</span>
            {data.tags.map(tag => (
              <span class="tag">{tag}</span>
            ))}
          </div>
        </footer>
      )}
    </article>
    {related.length > 0 && (
      <section class="related-section">
        <h2 class="related-title">Terkait</h2>
        <div class="related-grid">
          {related.map(p => <PostCard post={p} />)}
        </div>
      </section>
    )}
  </div>
</BaseLayout>

<style>
  .wrapper {
    padding-block: var(--s-6) var(--s-12);
    display: flex;
    flex-direction: column;
    gap: var(--s-8);
    max-width: 48rem;
  }

  article {
    display: flex;
    flex-direction: column;
    gap: var(--s-6);
    isolation: isolate;
    & header {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: var(--s-2);
      padding-block: var(--s-4);
      & span {
        text-transform: uppercase;
        font-weight: 500;
      }
      & h1 {
        font-size: var(--fs-4xl);
        font-weight: var(--fw-bold);
        line-height: var(--lh-tight);
        margin: 0;
        color: var(--text-primary);
        max-width: 30ch;
      }
      & .post-meta {
        display: flex;
        align-items: center;
        gap: var(--s-2);
        & .post-icon {
          display: inline-flex;
          align-items: center;
          justify-content: center;
          color: var(--accent);
          margin-block: var(--s-1);
          & :global(svg) {
            width: 1.5em;
            height: 1.5em;
            flex-shrink: 0;
          }
        }
        & .post-author {
          font-size: var(--fs-sm);
          color: var(--text-secondary);
          font-weight: var(--fw-medium);
          margin: 0;
        }
        & .post-date {
          font-size: var(--fs-sm);
          color: var(--text-secondary);
          margin: 0;
          letter-spacing: 0.05em;
          font-weight: var(--fw-medium);
          font-variant-numeric: tabular-nums;
        }
      }
    }
    & .cover {
      aspect-ratio: 16 / 9;
      overflow: hidden;
      margin-inline: calc(var(--pad-x) * -1);
      margin-block: 0;
      & img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
      }
    }
    & .post-body {
      margin: 0;
    }
    & .post-footer {
      display: flex;
      flex-direction: column;
      padding-top: var(--s-4);
      border-top: 1px solid var(--border);
      gap: 0.5rem;
      & .update {
        color: var(--text-muted);
        font-size: var(--fs-sm);
      }
      & .post-tags {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: var(--s-2);
      }
    }
  }
  .tags-label {
    font-size: var(--fs-xs);
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: var(--fw-semibold);
  }

  .tag {
    display: inline-block;
    padding: var(--s-1) var(--s-3);
    background: var(--bg-surface);
    border: 1px solid var(--border);
    font-size: var(--fs-xs);
    font-weight: var(--fw-medium);
    color: var(--text-secondary);
  }

  .related-section {
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
    padding-top: var(--s-6);
    border-top: 1px solid var(--border);
  }

  .related-title {
    font-size: var(--fs-lg);
    font-weight: var(--fw-semibold);
    margin: 0;
    color: var(--text-primary);
  }

  .related-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s-4);
  }

  @media (max-width: 50rem) {
    .post-meta {
      flex-direction: column;
    }
    .cover {
      margin-inline: 0;
    }
    .related-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 50rem) {
    .related-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>