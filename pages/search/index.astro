---
import { getCollection } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import Hero from '~/components/Hero.astro';
import Icon from '~/user-components/Icons.astro';
import Button from '~/user-components/Button.astro';
import AnimeCard from '~/components/AnimeCard.astro';

const allAnime = await getCollection('anime');
const sorted = [...allAnime].sort((a, b) =>
  a.data.title.localeCompare(b.data.title, 'id-ID')
);
---

<BaseLayout
  title="Cari Anime"
  description="Cari anime di Qimochi."
  noindex={true}
>
  <div class="wrapper">

    <Hero
      title="Cari Anime"
      description="Cari judul anime dengan cepat."
    />

    <form class="search-form" id="search-form">
      <div class="search-input-wrap">
        <span class="search-input-icon" aria-hidden="true">
          <Icon name="search" size={18} />
        </span>
        <input
          type="text"
          id="search-input"
          class="search-input"
          placeholder="Ketik judul anime..."
          autocomplete="off"
          spellcheck="false"
        />
        <button
          type="button"
          class="search-clear"
          id="search-clear"
          aria-label="Hapus pencarian"
          hidden
        >
          <Icon name="close" size={16} />
        </button>
      </div>

      <Button type="submit" variant="accent" size="md">
        Cari
      </Button>
    </form>

    <div id="search-empty" class="search-empty">
      <p>Mulai ketik untuk mencari anime.</p>
      <p class="search-empty-hint">
        Atau jelajahi <a href="/anime/">archive lengkap</a>.
      </p>
    </div>

    <div id="search-status" class="search-status" hidden></div>

    <div id="search-results" class="anime-grid" hidden>
      {sorted.map(anime => <AnimeCard anime={anime} />)}
    </div>

    <div class="load-more-wrap" id="load-more-wrap" hidden>
      <Button type="button" id="load-more-btn" variant="outline" size="md">
        <span id="load-more-text">Muat Lebih Banyak</span>
      </Button>
    </div>

  </div>
</BaseLayout>

<script>
  const BATCH_SIZE = 12;

  function normalize(s: string): string {
    return s
      .toLowerCase()
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .replace(/[^a-z0-9\s]/g, '')
      .replace(/\s+/g, ' ')
      .trim();
  }

  function levenshtein(a: string, b: string): number {
    if (a === b) return 0;
    if (a.length === 0) return b.length;
    if (b.length === 0) return a.length;

    const matrix: number[][] = [];
    for (let i = 0; i <= b.length; i++) matrix[i] = [i];
    for (let j = 0; j <= a.length; j++) matrix[0][j] = j;

    for (let i = 1; i <= b.length; i++) {
      for (let j = 1; j <= a.length; j++) {
        const cost = a[j - 1] === b[i - 1] ? 0 : 1;
        matrix[i][j] = Math.min(
          matrix[i - 1][j] + 1,
          matrix[i][j - 1] + 1,
          matrix[i - 1][j - 1] + cost
        );
      }
    }

    return matrix[b.length][a.length];
  }

  function scoreTitle(query: string, title: string): number {
    const q = normalize(query);
    const t = normalize(title);
    if (!q || !t) return 0;

    if (t.includes(q)) {
      const pos = t.indexOf(q);
      return 1 - (pos / t.length) * 0.3;
    }

    const words = t.split(' ');
    let best = 0;

    for (const word of words) {
      const dist = levenshtein(q, word);
      const maxLen = Math.max(q.length, word.length);
      const similarity = 1 - dist / maxLen;
      if (similarity > best) best = similarity;
    }

    if (q.length >= 3) {
      for (const word of words) {
        if (word.includes(q) || q.includes(word)) {
          best = Math.max(best, 0.85);
        }
      }
    }

    return best * 0.85;
  }

  /* ----------------------------------------------------------
     INIT
     ---------------------------------------------------------- */
  const form = document.getElementById('search-form') as HTMLFormElement;
  const input = document.getElementById('search-input') as HTMLInputElement;
  const clearBtn = document.getElementById('search-clear') as HTMLButtonElement;
  const emptyState = document.getElementById('search-empty')!;
  const status = document.getElementById('search-status')!;
  const results = document.getElementById('search-results')!;
  const loadMoreWrap = document.getElementById('load-more-wrap')!;
  const loadMoreBtn = document.getElementById('load-more-btn') as HTMLButtonElement;
  const loadMoreText = document.getElementById('load-more-text')!;

  const allCards = Array.from(
    results.querySelectorAll<HTMLElement>('[data-anime-title]')
  );

  let matchedCards: HTMLElement[] = [];
  let visibleCount = BATCH_SIZE;

  const params = new URLSearchParams(window.location.search);
  const initialQuery = params.get('q') || '';
  input.value = initialQuery;

  /* ----------------------------------------------------------
     RENDER — tampilkan N card pertama, sisanya hidden
     ---------------------------------------------------------- */
  function render() {
    const visible = matchedCards.slice(0, visibleCount);
    const visibleSet = new Set(visible);

    allCards.forEach(card => {
      card.style.display = visibleSet.has(card) ? '' : 'none';
    });

    const remaining = matchedCards.length - visibleCount;
    const hasMore = remaining > 0;
    loadMoreWrap.hidden = !hasMore;
    loadMoreText.textContent = hasMore
      ? `Muat Lebih Banyak (${remaining} lagi)`
      : 'Muat Lebih Banyak';
  }

  /* ----------------------------------------------------------
     FILTER
     ---------------------------------------------------------- */
  function applyFilter(query: string) {
    const q = query.trim();

    // Empty state — belum ada query
    if (q.length === 0) {
      emptyState.hidden = false;
      status.hidden = true;
      results.hidden = true;
      loadMoreWrap.hidden = true;
      return;
    }

    // Query terlalu pendek
    if (q.length < 2) {
      emptyState.hidden = true;
      status.textContent = 'Ketik minimal 2 karakter.';
      status.hidden = false;
      results.hidden = true;
      loadMoreWrap.hidden = true;
      return;
    }

    // Filter
    const scored = allCards
      .map(card => ({
        card,
        score: scoreTitle(q, card.dataset.animeTitle || ''),
      }))
      .filter(({ score }) => score > 0.4)
      .sort((a, b) => b.score - a.score);

    matchedCards = scored.map(s => s.card);
    visibleCount = BATCH_SIZE;

    emptyState.hidden = true;
    results.hidden = false;

    if (matchedCards.length === 0) {
      status.textContent = `Tidak ada hasil untuk "${q}".`;
      status.hidden = false;
      results.hidden = true;
      loadMoreWrap.hidden = true;
      return;
    }

    status.textContent = `${matchedCards.length} hasil untuk "${q}"`;
    status.hidden = false;
    render();
  }

  /* ----------------------------------------------------------
     EVENTS
     ---------------------------------------------------------- */
  function updateClearBtn() {
    clearBtn.hidden = input.value.length === 0;
  }

  input.addEventListener('input', updateClearBtn);
  updateClearBtn();

  clearBtn.addEventListener('click', () => {
    input.value = '';
    input.focus();
    updateClearBtn();
    applyFilter('');
    const url = new URL(window.location.href);
    url.searchParams.delete('q');
    window.history.pushState({}, '', url);
  });

  loadMoreBtn.addEventListener('click', () => {
    visibleCount += BATCH_SIZE;
    render();
  });

  form.addEventListener('submit', e => {
    e.preventDefault();
    const q = input.value.trim();
    const url = new URL(window.location.href);
    if (q) url.searchParams.set('q', q);
    else url.searchParams.delete('q');
    window.history.pushState({}, '', url);
    applyFilter(q);
  });

  window.addEventListener('popstate', () => {
    const p = new URLSearchParams(window.location.search);
    const q = p.get('q') || '';
    input.value = q;
    updateClearBtn();
    applyFilter(q);
  });

  // Initial
  applyFilter(initialQuery);
</script>

<style>
  .wrapper {
    padding-block: var(--s-6) var(--s-12);
    display: flex;
    flex-direction: column;
    gap: var(--s-6);
  }

  .search-form {
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
  }

  .search-input-wrap {
    position: relative;
    flex: 1;
    min-width: 0;
  }

  .search-input {
    width: 100%;
    min-width: 0;
    min-height: 2.25rem;
    padding: var(--s-2) var(--s-10) var(--s-2) calc(var(--s-4) * 2.5);
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--r-full);
    color: var(--text-primary);
    font-size: var(--fs-base);
    transition: border-color var(--t-fast);
  }
  .search-input-icon {
    position: absolute;
    left: var(--s-4);
    top: 50%;
    transform: translateY(-50%);
    z-index: 1;

    display: inline-flex;
    align-items: center;
    justify-content: center;

    color: var(--text-muted);
    pointer-events: none;
  }

  .search-input-icon :global(svg) {
    width: 1em;
    height: 1em;
    flex-shrink: 0;
  }

  .search-input::placeholder {
    color: var(--text-muted);
  }

  .search-input:focus {
    outline: none;
    border-color: var(--accent);
  }
  .search-input-wrap:focus-within .search-input-icon {
    color: var(--accent);
  }

  .search-input::-webkit-search-cancel-button,
  .search-input::-webkit-search-decoration {
    -webkit-appearance: none;
    appearance: none;
  }

  .search-clear {
    position: absolute;
    right: var(--s-2);
    top: 50%;
    transform: translateY(-50%);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    padding: 0;
    background: transparent;
    border: none;
    color: var(--text-muted);
    cursor: pointer;
    transition: color var(--t-fast);
  }

  .search-clear:hover {
    color: var(--text-primary);
  }

  .search-clear[hidden] {
    display: none;
  }

  .search-clear :global(svg) {
    width: 1em;
    height: 1em;
    flex-shrink: 0;
  }

  .search-empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--s-2);
    text-align: center;
    padding: var(--s-12) var(--s-4);
    color: var(--text-muted);
    font-size: var(--fs-sm);
  }

  .search-empty[hidden] {
    display: none;
  }

  .search-empty p {
    margin: 0;
  }

  .search-empty-hint {
    font-size: var(--fs-xs);
  }

  .search-empty a {
    position: relative;
    color: var(--accent);
    transition: color var(--t-fast);
    &::after {
      content: '';
      position: absolute;
      left: -3%;
      right: -3%;
      bottom: -0.1em;
      height: 0.45em;
      background-color: var(--accent);
      -webkit-mask-image: var(--underline);
      mask-image: var(--underline);
      -webkit-mask-size: 100% 100%;
      mask-size: 100% 100%;
      -webkit-mask-repeat: no-repeat;
      mask-repeat: no-repeat;
      pointer-events: none;
      opacity: 0;
      transition: opacity var(--t-fast);
    }
    &:hover {
      color: var(--accent-hover);
    }
    &:hover::after {
      opacity: 1;
    }
  }

  .search-status {
    color: var(--text-muted);
    font-size: var(--fs-sm);
  }

  .search-status[hidden] {
    display: none;
  }

  .anime-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-3);
  }

  .anime-grid[hidden] {
    display: none;
  }

  .load-more-wrap {
    display: flex;
    justify-content: center;
    padding-block: var(--s-4);
  }

  .load-more-wrap[hidden] {
    display: none;
  }

  @media (min-width: 50rem) {
    .search-form {
      flex-direction: row;
      align-items: center;
    }
    .anime-grid {
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: var(--s-4);
    }
  }
</style>