---
import { getCollection } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import Page from '~/components/Page.astro';
import Hero from '~/components/Hero.astro';
import AnimeBrowser from '~/components/AnimeBrowser.astro';
import { sortByRecent } from '~/lib/anime';
import { getGenres } from '~/lib/genre';

const all = sortByRecent(await getCollection('anime'));
const genres = (await getGenres()).filter((g) => g.count > 0);
---

<BaseLayout title="Cari anime" description="Cari anime berdasarkan judul." noindex>
  <Page>
    <Hero title="Cari anime" />
    <AnimeBrowser anime={all} genres={genres} autofocus />
  </Page>
</BaseLayout>
