---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Page from '~/components/Page.astro';
import FilterLayout from '~/components/FilterLayout.astro';
import EmptyState from '~/components/EmptyState.astro';
import AnimeCard from '~/components/AnimeCard.astro';
import Pagination from '~/components/Pagination.astro';
import StatusCard from '~/components/StatusCard.astro';
import GenresCard from '~/components/GenresCard.astro';
import StudiosCard from '~/components/StudiosCard.astro';
import TypesCard from '~/components/TypesCard.astro';
import SeasonsCard from '~/components/SeasonsCard.astro';
import YearsCard from '~/components/YearsCard.astro';
import Icon from '~/user-components/Icons.astro';
import LinkButton from '~/user-components/LinkButton.astro';
import Select from '~/user-components/Select.astro';
import { PER_PAGE } from '~/constants';

const DEFAULT_SORT = 'recent';

const SORTS = [
  { value: 'recent', label: 'Terbaru' },
  { value: 'oldest', label: 'Terlama' },
  { value: 'title', label: 'A-Z' },
  { value: 'rating', label: 'Rating' },
];
---

<BaseLayout title="Cari Anime" description="Cari dan filter anime di QimochiDB.">
  <link rel="preload" href="/api/v1/anime.json" as="fetch" crossorigin="anonymous" />
  <AnimeCard mode="template" />
  <Pagination mode="template" />

  <Page>
    <section class="search-hero">
      <h1 class="search-hero__title">Cari Anime</h1>
      <p class="search-hero__desc">
        Temukan anime favoritmu dari database QimochiDB.
      </p>
    </section>

    <form action="/search/anime/" method="get" class="search-form" role="search" data-search-form>
      <label for="q" class="sr-only">Cari anime</label>

      <div class="search-form__field">
        <input
          id="q"
          type="search"
          name="q"
          placeholder="Cari judul anime..."
          autocomplete="off"
          class="search-form__input"
          data-search-input
        />
        <button
          type="button"
          class="search-form__clear"
          data-search-clear
          aria-label="Bersihkan pencarian"
          hidden
        >
          <Icon name="close" size={14} />
        </button>
      </div>

      <button type="submit" class="search-form__submit">Cari</button>
    </form>

    <FilterLayout>
      <div class="controls-row">
        <div class="controls-row__sorts">
          <Select
            id="sort"
            label="Urutkan"
            options={SORTS}
            value={DEFAULT_SORT}
            size="sm"
            data-sort
          />
        </div>

        <LinkButton
          href="/search/anime/"
          variant="ghost"
          size="sm"
          data-reset
          hidden
        >
          Reset
        </LinkButton>
      </div>

      <p class="result-count" data-result-count>Memuat...</p>

      <div class="search-loading" data-loading>Memuat data...</div>

      <div
        class="anime-grid"
        data-grid
        data-per-page={PER_PAGE}
        data-default-sort={DEFAULT_SORT}
        hidden
      ></div>

      <div data-empty-state hidden>
        <EmptyState
          title="Tidak ada anime ditemukan"
          message="Coba ubah kata kunci atau filter."
        />
      </div>

      <nav class="search-pagination" data-pagination aria-label="Navigasi halaman"></nav>

      <div slot="sidebar" class="sidebar-widgets">
        <StatusCard />
        <GenresCard />
        <StudiosCard />
        <TypesCard />
        <SeasonsCard />
        <YearsCard />
      </div>
    </FilterLayout>
  </Page>
</BaseLayout>

<script>
  // @ts-nocheck
  import { buildPages, paginateList } from '~/lib/pagination';
  import { cloneTemplate } from '~/lib/dom';

  const gridEl = document.querySelector('[data-grid]');
  const PER_PAGE = Number(gridEl?.dataset.perPage ?? 24);
  const DEFAULT_SORT = gridEl?.dataset.defaultSort ?? 'recent';

  const grid = gridEl;
  const loading = document.querySelector('[data-loading]');
  const resultCount = document.querySelector('[data-result-count]');
  const emptyState = document.querySelector('[data-empty-state]');
  const paginationEl = document.querySelector('[data-pagination]');
  const searchInput = document.querySelector('[data-search-input]');
  const searchForm = document.querySelector('[data-search-form]');
  const clearBtn = document.querySelector('[data-search-clear]');
  const resetBtn = document.querySelector('[data-reset]');
  const cardTemplate = document.getElementById('anime-card-template');

  const sortEl = document.querySelector('[data-sort]');

  const SORT_VALUES = ['recent', 'oldest', 'title', 'rating'];

  let animeIndex = [];

  function readParams() {
    const sp = new URLSearchParams(location.search);
    return {
      q: (sp.get('q') ?? '').trim(),
      status: sp.get('status') ?? '',
      type: sp.get('type') ?? '',
      genre: sp.get('genre') ?? '',
      studio: sp.get('studio') ?? '',
      season: sp.get('season') ?? '',
      year: sp.get('year') ?? '',
      sort: sp.get('sort') ?? DEFAULT_SORT,
      page: Math.max(1, Number(sp.get('page') ?? 1)),
    };
  }

  function buildUrl(p) {
    const sp = new URLSearchParams();
    if (p.q) sp.set('q', p.q);
    if (p.status) sp.set('status', p.status);
    if (p.type) sp.set('type', p.type);
    if (p.genre) sp.set('genre', p.genre);
    if (p.studio) sp.set('studio', p.studio);
    if (p.season) sp.set('season', p.season);
    if (p.year) sp.set('year', p.year);
    if (p.sort && p.sort !== DEFAULT_SORT) sp.set('sort', p.sort);
    if (p.page > 1) sp.set('page', String(p.page));
    const qs = sp.toString();
    return qs ? `${location.pathname}?${qs}` : location.pathname;
  }

  function matches(entry, p) {
    const d = entry.item;
    if (p.status && d.status !== p.status) return false;
    if (p.type && d.type !== p.type) return false;
    if (p.season && d.season !== p.season) return false;
    if (p.year && d.year !== Number(p.year)) return false;
    if (p.genre && !d.genres.includes(p.genre)) return false;
    if (p.studio && !d.studios.includes(p.studio)) return false;
    if (p.q && !entry.search.includes(p.q.toLowerCase())) return false;
    return true;
  }

  function sortList(list, sort) {
    const copy = [...list];
    switch (sort) {
      case 'rating':
        return copy.sort(
          (a, b) => (b.stats?.score ?? 0) - (a.stats?.score ?? 0)
        );
      case 'oldest':
        return copy.sort((a, b) => (a.year ?? 9999) - (b.year ?? 9999));
      case 'title':
        return copy.sort((a, b) => a.title.localeCompare(b.title));
      case 'recent':
      default:
        return copy.sort((a, b) => (b.year ?? 0) - (a.year ?? 0));
    }
  }

  function createCard(a) {
    if (!cardTemplate) return null;

    const node = cardTemplate.content.cloneNode(true);
    const link = node.querySelector('.anime-card__link');
    const img = node.querySelector('.anime-card__img');
    const placeholder = node.querySelector('.anime-card__placeholder');
    const titleEl = node.querySelector('.anime-card__title');

    if (!link || !img || !placeholder || !titleEl) return null;

    link.href = `/anime/${a.id}/`;
    link.setAttribute('aria-label', a.title);
    titleEl.textContent = a.title;

    if (a.image) {
      img.src = a.image;
      img.hidden = false;
      placeholder.hidden = true;

      if (!img.complete || img.naturalWidth === 0) {
        img.setAttribute('data-loading', '');
      }

      const onLoad = () => img.removeAttribute('data-loading');
      const onError = () => {
        img.removeAttribute('data-loading');
        img.hidden = true;
        placeholder.hidden = false;
      };

      if (img.complete && img.naturalWidth > 0) {
        onLoad();
      } else {
        img.addEventListener('load', onLoad, { once: true });
        img.addEventListener('error', onError, { once: true });
      }
    } else {
      img.hidden = true;
      placeholder.hidden = false;
    }

    return node.firstElementChild;
  }

  function renderPagination(current, total, p) {
    paginationEl.innerHTML = '';
    if (total <= 1) return;

    const pageUrl = (n) => buildUrl({ ...p, page: n });
    const pages = buildPages(current, total);

    if (current > 1) {
      const el = cloneTemplate('pg-prev');
      el.href = pageUrl(current - 1);
      el.setAttribute('data-page', String(current - 1));
      paginationEl.appendChild(el);
    } else {
      paginationEl.appendChild(cloneTemplate('pg-prev-disabled'));
    }

    pages.forEach((pg) => {
      if (pg === '...') {
        paginationEl.appendChild(cloneTemplate('pg-ellipsis'));
      } else if (pg === current) {
        const el = cloneTemplate('pg-number-active');
        el.textContent = String(pg);
        paginationEl.appendChild(el);
      } else {
        const el = cloneTemplate('pg-number');
        el.textContent = String(pg);
        el.href = pageUrl(pg);
        el.setAttribute('data-page', String(pg));
        paginationEl.appendChild(el);
      }
    });

    if (current < total) {
      const el = cloneTemplate('pg-next');
      el.href = pageUrl(current + 1);
      el.setAttribute('data-page', String(current + 1));
      paginationEl.appendChild(el);
    } else {
      paginationEl.appendChild(cloneTemplate('pg-next-disabled'));
    }
  }

  function render(p) {
    const filtered = animeIndex.filter((e) => matches(e, p));
    const sorted = sortList(
      filtered.map((e) => e.item),
      p.sort
    );

    const { items: pageItems, total, totalPages, currentPage: current } =
      paginateList(sorted, p.page, PER_PAGE);

    grid.innerHTML = '';
    const frag = document.createDocumentFragment();
    pageItems.forEach((a) => {
      const card = createCard(a);
      if (card) frag.appendChild(card);
    });
    grid.appendChild(frag);

    resultCount.textContent = `${total} anime ditemukan`;

    if (document.activeElement !== searchInput) {
      searchInput.value = p.q;
    }

    if (clearBtn) clearBtn.hidden = !searchInput.value;

    if (sortEl) {
      sortEl.value = SORT_VALUES.includes(p.sort) ? p.sort : DEFAULT_SORT;
    }

    const isEmpty = total === 0;
    emptyState.hidden = !isEmpty;
    grid.hidden = isEmpty;

    if (resetBtn) {
      const hasNonDefault =
        p.q ||
        p.status ||
        p.type ||
        p.genre ||
        p.studio ||
        p.season ||
        p.year ||
        p.sort !== DEFAULT_SORT ||
        p.page > 1;
      resetBtn.hidden = !hasNonDefault;
    }

    document.querySelectorAll('[data-filter-key]').forEach((el) => {
      const key = el.dataset.filterKey;
      const value = el.dataset.filterValue ?? '';
      const currentValue = p[key] ?? '';
      el.classList.toggle('is-active', value === currentValue);
    });

    renderPagination(current, totalPages, p);

    document.title = p.q
      ? `Hasil untuk "${p.q}" — QimochiDB`
      : 'Cari Anime — QimochiDB';
  }

  function navigate(p) {
    history.pushState({}, '', buildUrl(p));
    render(p);
    window.scrollTo({ top: 0, behavior: 'smooth' });
    window.dispatchEvent(new Event('filter-updated'));
  }

  async function init() {
    try {
      const res = await fetch('/api/v1/anime.json', {
        headers: { Accept: 'application/json' },
      });
      if (!res.ok) throw new Error(`HTTP ${res.status}`);

      const json = await res.json();
      const allAnime = json.data ?? [];

      animeIndex = allAnime.map((item) => ({
        item,
        search: [
          item.title,
          item.titleEnglish ?? '',
          item.titleNative ?? '',
        ]
          .join(' ')
          .toLowerCase(),
      }));

      loading.hidden = true;
      grid.hidden = false;
      render(readParams());
    } catch (err) {
      loading.textContent = 'Gagal memuat data. Coba refresh halaman.';
      console.error('[search]', err);
    }
  }

  document.addEventListener('click', (e) => {
    const target = e.target;
    if (!(target instanceof Element)) return;

    const resetEl = target.closest('[data-reset]');
    if (resetEl) {
      e.preventDefault();
      navigate({
        q: '',
        status: '',
        type: '',
        genre: '',
        studio: '',
        season: '',
        year: '',
        sort: DEFAULT_SORT,
        page: 1,
      });
      return;
    }

    const clearEl = target.closest('[data-search-clear]');
    if (clearEl) {
      e.preventDefault();
      searchInput.value = '';
      searchInput.focus();
      navigate({ ...readParams(), q: '', page: 1 });
      return;
    }

    const filterEl = target.closest('[data-filter-key]');
    if (filterEl) {
      e.preventDefault();
      const key = filterEl.dataset.filterKey;
      const value = filterEl.dataset.filterValue ?? '';
      const currentValue = readParams()[key] ?? '';
      const newValue = value === currentValue ? '' : value;
      navigate({ ...readParams(), [key]: newValue, page: 1 });
      return;
    }

    const pageLink = target.closest('a[data-page]');
    if (pageLink) {
      e.preventDefault();
      navigate({
        ...readParams(),
        page: Number(pageLink.dataset.page),
      });
      return;
    }
  });

  searchForm.addEventListener('submit', (e) => {
    e.preventDefault();
    navigate({
      ...readParams(),
      q: searchInput.value.trim(),
      page: 1,
    });
  });

  searchInput.addEventListener('input', () => {
    if (clearBtn) clearBtn.hidden = !searchInput.value;
  });

  sortEl?.addEventListener('change', () => {
    navigate({
      ...readParams(),
      sort: sortEl.value,
      page: 1,
    });
  });

  window.addEventListener('popstate', () => render(readParams()));

  init();
</script>

<style>
  .search-hero {
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
  }

  .search-hero__title {
    margin: 0;
    font-size: var(--fs-2xl);
    font-weight: var(--fw-bold);
    line-height: var(--lh-tight);
    color: var(--text-primary);
  }

  .search-hero__desc {
    margin: 0;
    max-width: 40rem;
    font-size: var(--fs-sm);
    color: var(--text-secondary);
  }

  @media (min-width: 50rem) {
    .search-hero__title { font-size: var(--fs-3xl); }
    .search-hero__desc { font-size: var(--fs-base); }
  }

  .search-form {
    display: flex;
    width: 100%;
  }

  .search-form__field {
    position: relative;
    flex: 1;
    min-width: 0;
    display: flex;
  }

  .search-form__input {
    flex: 1;
    min-width: 0;
    padding: var(--s-3) var(--s-10) var(--s-3) var(--s-4);
    font: inherit;
    font-size: var(--fs-sm);
    color: var(--text-primary);
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--r-md) 0 0 var(--r-md);
    transition: border-color var(--t-fast);
    appearance: none;
    -webkit-appearance: none;
  }

  .search-form__input::-webkit-search-cancel-button {
    -webkit-appearance: none;
    display: none;
  }

  .search-form__input:focus {
    outline: none;
    border-color: var(--accent);
  }

  .search-form__clear {
    position: absolute;
    top: 50%;
    right: var(--s-3);
    transform: translateY(-50%);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.5rem;
    height: 1.5rem;
    padding: 0;
    background: transparent;
    border: none;
    border-radius: var(--r-full);
    color: var(--text-muted);
    cursor: pointer;
    transition: color var(--t-fast), background-color var(--t-fast);
  }

  .search-form__clear[hidden] { display: none; }

  .search-form__clear:hover {
    color: var(--text-primary);
    background: var(--bg-hover);
  }

  .search-form__submit {
    padding-inline: var(--s-5);
    font: inherit;
    font-size: var(--fs-sm);
    font-weight: var(--fw-medium);
    color: var(--accent-text);
    background: var(--accent);
    border: 1px solid var(--accent);
    border-radius: 0 var(--r-md) var(--r-md) 0;
    cursor: pointer;
    transition: background-color var(--t-fast);
  }

  .search-form__submit:hover {
    background: var(--accent-hover);
    border-color: var(--accent-hover);
  }

  .controls-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--s-3);
  }

  .controls-row__sorts {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--s-2);
  }

  .result-count {
    margin: 0;
    font-size: var(--fs-sm);
    color: var(--text-muted);
  }

  .anime-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--s-4);
  }

  @media (min-width: 50rem) {
    .anime-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: var(--s-5);
    }
  }

  @media (min-width: 72rem) {
    .anime-grid {
      grid-template-columns: repeat(6, 1fr);
    }
  }

  .sidebar-widgets {
    display: flex;
    flex-direction: column;
    gap: var(--s-8);
  }

  .search-loading {
    padding: var(--s-10) var(--s-6);
    text-align: center;
    color: var(--text-muted);
    font-size: var(--fs-sm);
  }
</style>
