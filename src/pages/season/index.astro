---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Page from '~/components/Page.astro';
import Breadcrumb from '~/components/Breadcrumb.astro';
import SectionLabel from '~/components/SectionLabel.astro';
import EmptyState from '~/components/EmptyState.astro';
import AnimeCard from '~/components/AnimeCard.astro';
import { SEASONS, SEASON_LABEL, type Season } from '~/constants';

const SEASON_ORDER: Record<Season, number> = {
  winter: 0,
  spring: 1,
  summer: 2,
  fall: 3,
};
---

<BaseLayout
  title="Musim"
  description="Jelajahi anime berdasarkan musim tayang."
>
  <AnimeCard mode="template" />

  <Page>
    <Breadcrumb
      items={[
        { label: 'Home', href: '/' },
        { label: 'Musim' },
      ]}
    />

    <header class="season-header">
      <SectionLabel as="h1" size="lg">Musim</SectionLabel>
      <p class="season-header__desc">
        Jelajahi anime berdasarkan musim tayang.
      </p>
    </header>

    <div class="season-picker" data-season-picker hidden>
      <button type="button" class="season-chip" data-season="">
        Semua
      </button>
    </div>

    <p class="season-count" data-season-count hidden></p>

    <div class="season-loading" data-season-loading>Memuat data...</div>

    <div class="season-grid" data-season-grid hidden></div>

    <div data-season-empty hidden>
      <EmptyState
        title="Tidak ada anime"
        message="Belum ada anime untuk musim ini."
      />
    </div>
  </Page>
</BaseLayout>

<script>
  // @ts-nocheck
  import { cloneTemplate } from '~/lib/dom';

  const SEASON_LABEL: Record<string, string> = {
    winter: 'Winter',
    spring: 'Spring',
    summer: 'Summer',
    fall: 'Fall',
  };

  const SEASON_ORDER: Record<string, number> = {
    winter: 0,
    spring: 1,
    summer: 2,
    fall: 3,
  };

  const pickerEl = document.querySelector('[data-season-picker]');
  const gridEl = document.querySelector('[data-season-grid]');
  const loadingEl = document.querySelector('[data-season-loading]');
  const emptyEl = document.querySelector('[data-season-empty]');
  const countEl = document.querySelector('[data-season-count]');
  const cardTemplate = document.getElementById('anime-card-template');

  let allAnime = [];
  let seasonKeys = [];

  function getSelected() {
    const sp = new URLSearchParams(location.search);
    return sp.get('season') ?? '';
  }

  function setSelected(key) {
    const url = new URL(location.href);
    if (key) {
      url.searchParams.set('season', key);
    } else {
      url.searchParams.delete('season');
    }
    history.pushState({}, '', url.toString());
    render();
  }

  function makeCard(anime) {
    if (!cardTemplate) return null;
    const node = cardTemplate.content.cloneNode(true);
    const link = node.querySelector('.anime-card__link');
    const img = node.querySelector('.anime-card__img');
    const placeholder = node.querySelector('.anime-card__placeholder');
    const titleEl = node.querySelector('.anime-card__title');

    link.href = `/anime/${anime.id}/`;
    link.setAttribute('aria-label', anime.title);
    titleEl.textContent = anime.title;

    if (anime.image) {
      img.src = anime.image;
      img.hidden = false;
      placeholder.hidden = true;
    } else {
      img.hidden = true;
      placeholder.hidden = false;
    }

    return node.firstElementChild;
  }

  function buildPicker() {
    const counts = new Map<string, number>();
    for (const anime of allAnime) {
      const y = anime.year;
      const s = anime.season;
      if (!y || !s) continue;
      const key = `${y}-${s}`;
      counts.set(key, (counts.get(key) ?? 0) + 1);
    }

    seasonKeys = [...counts.keys()].sort((a, b) => {
      const [ya, sa] = a.split('-');
      const [yb, sb] = b.split('-');
      if (Number(yb) !== Number(ya)) return Number(yb) - Number(ya);
      return SEASON_ORDER[sb] - SEASON_ORDER[sa];
    });

    pickerEl.innerHTML = '';

    const allBtn = document.createElement('button');
    allBtn.type = 'button';
    allBtn.className = 'season-chip';
    allBtn.dataset.season = '';
    allBtn.textContent = 'Semua';
    pickerEl.appendChild(allBtn);

    for (const key of seasonKeys) {
      const [yearStr, season] = key.split('-');
      const chip = document.createElement('button');
      chip.type = 'button';
      chip.className = 'season-chip';
      chip.dataset.season = key;
      chip.textContent = `${SEASON_LABEL[season]} ${yearStr}`;
      chip.dataset.count = String(counts.get(key) ?? 0);
      pickerEl.appendChild(chip);
    }

    pickerEl.hidden = false;
  }

  function render() {
    const selected = getSelected();

    pickerEl.querySelectorAll('[data-season]').forEach((chip) => {
      const isActive = chip.dataset.season === selected;
      chip.classList.toggle('is-active', isActive);
    });

    const filtered = selected
      ? allAnime.filter((a) => `${a.year}-${a.season}` === selected)
      : allAnime;

    const sorted = [...filtered].sort((a, b) => {
      const yA = a.year ?? 0;
      const yB = b.year ?? 0;
      if (yB !== yA) return yB - yA;
      const sA = SEASON_ORDER[a.season] ?? -1;
      const sB = SEASON_ORDER[b.season] ?? -1;
      if (sB !== sA) return sB - sA;
      return a.title.localeCompare(b.title);
    });

    gridEl.innerHTML = '';
    const frag = document.createDocumentFragment();
    for (const anime of sorted) {
      const card = makeCard(anime);
      if (card) frag.appendChild(card);
    }
    gridEl.appendChild(frag);

    countEl.textContent = `${sorted.length} anime`;
    countEl.hidden = false;

    const isEmpty = sorted.length === 0;
    emptyEl.hidden = !isEmpty;
    gridEl.hidden = isEmpty;

    document.title = selected
      ? `${SEASON_LABEL[selected.split('-')[1]]} ${selected.split('-')[0]} — Musim — Yukionime`
      : 'Musim — Yukionime';
  }

  async function init() {
    try {
      const res = await fetch('/api/v1/anime.json', {
        headers: { Accept: 'application/json' },
      });
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const json = await res.json();
      allAnime = json.data ?? [];

      loadingEl.hidden = true;
      gridEl.hidden = false;

      buildPicker();
      render();
    } catch (err) {
      loadingEl.textContent = 'Gagal memuat data. Coba refresh halaman.';
      console.error('[season]', err);
    }
  }

  pickerEl.addEventListener('click', (e) => {
    const btn = e.target.closest('[data-season]');
    if (!btn) return;
    setSelected(btn.dataset.season ?? '');
  });

  window.addEventListener('popstate', render);

  init();
</script>

<style>
  .season-header {
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
  }

  .season-header__desc {
    margin: 0;
    max-width: 40rem;
    font-size: var(--fs-sm);
    color: var(--text-secondary);
  }

  .season-picker {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
  }

  .season-chip {
    padding: var(--s-1) var(--s-3);
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--r-full);
    color: var(--text-secondary);
    font-size: var(--fs-xs);
    font-weight: var(--fw-medium);
    cursor: pointer;
    transition: border-color var(--t-fast), background-color var(--t-fast), color var(--t-fast);
    white-space: nowrap;
  }

  .season-chip:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .season-chip.is-active {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--accent-text);
  }

  .season-count {
    margin: 0;
    font-size: var(--fs-sm);
    color: var(--text-muted);
  }

  .season-loading {
    padding: var(--s-10) var(--s-6);
    text-align: center;
    color: var(--text-muted);
    font-size: var(--fs-sm);
  }

  .season-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--s-4);
  }

  @media (min-width: 50rem) {
    .season-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: var(--s-5);
    }
  }

  @media (min-width: 72rem) {
    .season-grid {
      grid-template-columns: repeat(6, 1fr);
    }
  }
</style>