---
import { getAllAnime } from '~/lib/anime';

import BaseLayout from '~/layouts/BaseLayout.astro';
import Page from '~/components/Page.astro';
import Hero from '~/components/Hero.astro';
import PageLayout from '~/components/PageLayout.astro';
import AnimeSection from '~/components/AnimeSection.astro';
import GenresCard from '~/components/GenresCard.astro';
import { SITE } from '~/constants';

const allAnime = await getAllAnime();

const PER_SECTION = 12;

const trending = [...allAnime]
  .sort((a, b) => {
    const votesA = a.data.stats?.scoredBy ?? 0;
    const votesB = b.data.stats?.scoredBy ?? 0;
    if (votesB !== votesA) return votesB - votesA;

    const scoreA = a.data.stats?.score ?? 0;
    const scoreB = b.data.stats?.score ?? 0;
    return scoreB - scoreA;
  })
  .slice(0, PER_SECTION);

const topAiring = [...allAnime]
  .filter((a) => a.data.status === 'airing')
  .sort((a, b) => {
    const scoreA = a.data.stats?.score ?? 0;
    const scoreB = b.data.stats?.score ?? 0;
    if (scoreB !== scoreA) return scoreB - scoreA;

    return (b.data.year ?? 0) - (a.data.year ?? 0);
  })
  .slice(0, PER_SECTION);

const completed = [...allAnime]
  .filter((a) => a.data.status === 'finished')
  .sort((a, b) => {
    const yearA = a.data.year ?? 0;
    const yearB = b.data.year ?? 0;
    if (yearB !== yearA) return yearB - yearA;

    const scoreA = a.data.stats?.score ?? 0;
    const scoreB = b.data.stats?.score ?? 0;
    return scoreB - scoreA;
  })
  .slice(0, PER_SECTION);
---

<BaseLayout
  title={SITE.title}
  description={SITE.description}
>
  <Page>
    <Hero
      title={SITE.name}
      tagline={SITE.description}
      isSearch
    />

    <PageLayout>
      <AnimeSection
        title="Trending"
        href="/search/anime/?sort=trending"
        items={trending}
      />

      <AnimeSection
        title="Ongoing"
        href="/search/anime/?status=airing&sort=rating"
        items={topAiring}
      />

      <AnimeSection
        title="Completed"
        href="/search/anime/?status=finished"
        items={completed}
      />

      <div slot="sidebar">
        <GenresCard />
      </div>
    </PageLayout>
  </Page>
</BaseLayout>
