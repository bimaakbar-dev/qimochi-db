---
import { getCollection } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import Page from '~/components/Page.astro';
import Hero from '~/components/Hero.astro';
import PageLayout from '~/components/PageLayout.astro';
import AnimeSection from '~/components/AnimeSection.astro';
import GenresCard from '~/components/GenresCard.astro';

const allAnime = await getCollection('anime', ({ data }) => !data.draft);

const PER_SECTION = 8;

const trending = [...allAnime]
  .sort((a, b) => (a.data.stats?.popularity ?? 9999) - (b.data.stats?.popularity ?? 9999))
  .slice(0, PER_SECTION);

const topAiring = [...allAnime]
  .filter((a) => a.data.status === 'airing')
  .sort((a, b) => (b.data.stats?.score ?? 0) - (a.data.stats?.score ?? 0))
  .slice(0, PER_SECTION);

const upcoming = [...allAnime]
  .filter((a) => a.data.status === 'upcoming')
  .sort((a, b) => (a.data.year ?? 0) - (b.data.year ?? 0))
  .slice(0, PER_SECTION);
---

<BaseLayout
  title="QimochiDB"
  description="Database anime Indonesia — katalog lengkap, API gratis untuk developer."
>
  <Page>
    <Hero
      title="QimochiDB"
      tagline="Database anime Indonesia — katalog lengkap, API gratis."
      isSearch
    />

    <PageLayout>
      <AnimeSection
        title="Trending"
        href="/search/anime/?sort=trending"
        items={trending}
      />

      <AnimeSection
        title="Ongoing"
        href="/search/anime/?status=airing&sort=rating"
        items={topAiring}
      />

      <AnimeSection
        title="Upcoming"
        href="/search/anime/?status=upcoming"
        items={upcoming}
      />

      <div slot="sidebar">
        <GenresCard />
      </div>
    </PageLayout>
  </Page>
</BaseLayout>