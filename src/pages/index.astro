---
import { getAllAnime } from '~/lib/anime';

import BaseLayout from '~/layouts/BaseLayout.astro';
import Page from '~/components/Page.astro';
import Hero from '~/components/Hero.astro';
import PageLayout from '~/components/PageLayout.astro';
import AnimeSection from '~/components/AnimeSection.astro';
import GenresCard from '~/components/GenresCard.astro';
import { SITE } from '~/constants';

const allAnime = await getAllAnime();

const PER_SECTION = 8;

const trending = [...allAnime]
  .sort((a, b) => (b.data.stats?.scoredBy ?? 0) - (a.data.stats?.scoredBy ?? 0))
  .slice(0, PER_SECTION);

const topAiring = [...allAnime]
  .filter((a) => a.data.status === 'airing')
  .sort((a, b) => (b.data.stats?.score ?? 0) - (a.data.stats?.score ?? 0))
  .slice(0, PER_SECTION);

const finished = [...allAnime]
  .filter((a) => a.data.status === 'finished')
  .sort((a, b) => (a.data.year ?? 0) - (b.data.year ?? 0))
  .slice(0, PER_SECTION);
---

<BaseLayout
  title={SITE.title}
  description={SITE.description}
>
  <Page>
    <Hero
      title={SITE.name}
      tagline={SITE.description}
      isSearch
    />

    <PageLayout>
      <AnimeSection
        title="Trending"
        href="/search/anime/?sort=trending"
        items={trending}
      />

      <AnimeSection
        title="Ongoing"
        href="/search/anime/?status=airing&sort=rating"
        items={topAiring}
      />

      <AnimeSection
        title="Completed"
        href="/search/anime/?status=finished"
        items={finished}
      />

      <div slot="sidebar">
        <GenresCard />
      </div>
    </PageLayout>
  </Page>
</BaseLayout>
