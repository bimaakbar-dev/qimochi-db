---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Page from '~/components/Page.astro';
import Hero from '~/components/Hero.astro';
import LinkButton from '~/user-components/LinkButton.astro';
---

<BaseLayout title="Halaman tidak ditemukan" noindex>
  <Page>
    <Hero
      title="Halaman tidak ditemukan"
      description="Alamat yang kamu buka tidak ada atau sudah dipindahkan."
    >
      <div class="actions">
        <LinkButton href="/" variant="accent">Ke beranda</LinkButton>
        <LinkButton href="/anime/" variant="gold">Buka katalog</LinkButton>
      </div>
    </Hero>
  </Page>
</BaseLayout>

<style>
  .actions { display: flex; flex-wrap: wrap; gap: var(--s-3); }
</style>