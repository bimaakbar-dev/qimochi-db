---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Page from '~/components/Page.astro';
import Hero from '~/components/Hero.astro';
import LinkCard from '~/user-components/LinkCard.astro';
import { URLS } from '~/constants';
import { getGenres } from '~/lib/genre';

const genres = await getGenres();
---

<BaseLayout title="Genre" description="Jelajahi anime berdasarkan genre.">
  <Page>
    <Hero title="Genre" description="Pilih genre untuk melihat anime di dalamnya." />
    <ul class="list">
      {
        genres.map((g) => (
          <li>
            <LinkCard href={URLS.genre(g.id)} padding="md">
              <span class="name">{g.name}</span>
              <span class="count">{g.count} anime</span>
            </LinkCard>
          </li>
        ))
      }
    </ul>
  </Page>
</BaseLayout>

<style>
  .list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(11rem, 1fr));
    gap: var(--s-3);
    margin: 0;
    padding: 0;
  }

  .name {
    display: block;
    color: var(--text-primary);
    font-weight: var(--fw-semibold);
  }

  .count {
    color: var(--text-muted);
    font-size: var(--fs-xs);
  }
</style>