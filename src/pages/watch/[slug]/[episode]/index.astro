---
import { getCollection } from 'astro:content';
import { URLS } from '~/constants';

import BaseLayout from '~/layouts/BaseLayout.astro';
import Player from '~/components/Player.astro';
import WatchTitle from '~/components/WatchTitle.astro';
import StreamSelector from '~/components/StreamSelector.astro';
import ActionBar from '~/components/ActionBar.astro';
import DownloadPanel from '~/components/DownloadPanel.astro';
import EpisodeList from '~/components/EpisodeList.astro';

export async function getStaticPaths() {
  const allAnime = await getCollection('anime');
  const paths = [];

  for (const anime of allAnime) {
    for (const ep of anime.data.episodes) {
      paths.push({
        params: {
          slug: anime.id,
          episode: String(ep.number),
        },
        props: { anime, episode: ep },
      });
    }
  }

  return paths;
}

const { anime, episode } = Astro.props;
const { data } = anime;

const episodeNumbers = data.episodes
  .map(e => e.number)
  .sort((a, b) => a - b);

const totalEpisodes = episodeNumbers.length;

const defaultStream = episode.streams[0];
const playerSrc = defaultStream?.servers[0]?.url ?? '';

const downloads = episode.downloads ?? data.batch ?? [];
---

<BaseLayout
  title={`${data.title} Episode ${episode.number}`}
  description={`Nonton ${data.title} episode ${episode.number} subtitle Indonesia.`}
  image={data.cover}
  type="video.other"
  canonical={`/watch/${anime.id}/${episode.number}/`}
>
  <div class="wrapper">

    <section class="player-section">
      <Player src={playerSrc} title={`${data.title} Episode ${episode.number}`} />
    </section>

    <div class="content-grid">
      <div class="content-main">
        <WatchTitle title={data.title} episodeNumber={episode.number} slug={anime.id} />

        <StreamSelector streams={episode.streams} />

        <ActionBar
          slug={anime.id}
          episodeNumber={episode.number}
          totalEpisodes={totalEpisodes}
        />

        {downloads.length > 0 && <DownloadPanel downloads={downloads} />}
      </div>

      <aside class="content-aside">
        <EpisodeList
          slug={anime.id}
          episodes={episodeNumbers}
          currentEpisode={episode.number}
        />
      </aside>
    </div>

  </div>
</BaseLayout>

<style>
  .wrapper {
    padding-block: var(--s-4) var(--s-12);
  }

  .breadcrumb-wrap {
    margin-bottom: var(--s-4);
  }

  .player-section {
    margin-bottom: var(--s-5);
  }

  .content-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s-4);
    align-items: start;
  }

  .content-main {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
  }

  @media (min-width: 50rem) {
    .content-grid {
      grid-template-columns: 1fr var(--aside-width);
      gap: var(--s-6);
    }

    .content-aside {
      position: sticky;
      top: var(--sticky-top);
      max-height: calc(100vh - var(--sticky-top) - var(--s-4));
      overflow-y: auto;
    }
  }
</style>