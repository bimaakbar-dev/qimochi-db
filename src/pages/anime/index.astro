---
import { getCollection } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import Page from '~/components/Page.astro';
import Hero from '~/components/Hero.astro';
import AnimeBrowser from '~/components/AnimeBrowser.astro';
import { sortByRecent } from '~/lib/anime';
import { getGenres } from '~/lib/genre';

const all = sortByRecent(await getCollection('anime'));
const genres = (await getGenres()).filter((g) => g.count > 0);
---

<BaseLayout
  title="Katalog anime"
  description="Seluruh katalog anime: cari dan filter berdasarkan status, tipe, dan genre."
>
  <Page>
    <Hero title="Katalog anime" description="Cari dan filter seluruh anime di database." />
    <AnimeBrowser anime={all} genres={genres} />
  </Page>
</BaseLayout>
