---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Hero from '~/components/Hero.astro';
import AnimeCard from '~/components/AnimeCard.astro';
import Pagination from '~/components/Pagination.astro';
import { getStatusData, buildStatusPaths, paginate } from '~/lib/status';

export async function getStaticPaths() {
  const { anime, totalPages } = await getStatusData('ongoing');
  return buildStatusPaths('ongoing', anime, totalPages);
}

const { anime, totalPages, pageNumber } = Astro.props;
const items = paginate(anime, pageNumber);
const isFirstPage = pageNumber === 1;

const title = isFirstPage
  ? 'Anime Ongoing'
  : `Anime Ongoing — Halaman ${pageNumber}`;

const description = isFirstPage
  ? `Koleksi ${anime.length} anime yang sedang tayang.`
  : `${anime.length} anime · Halaman ${pageNumber} dari ${totalPages}`;
---

<BaseLayout
  title={title}
  description={description}
  canonical="/anime/ongoing/"
  noindex={!isFirstPage}
>
  <div class="wrapper">

    <Hero
      title="Anime Ongoing"
      description={description}
    />

    {items.length > 0 ? (
      <div class="anime-grid">
        {items.map(a => <AnimeCard anime={a} />)}
      </div>
    ) : (
      <p class="empty">Belum ada anime ongoing.</p>
    )}

    <Pagination
      current={pageNumber}
      total={totalPages}
      base="/anime/ongoing"
    />
  </div>
</BaseLayout>

<style>
  /* ----------------------------------------------------------
     WRAPPER
     ---------------------------------------------------------- */
  .wrapper {
    padding-block: var(--s-6) var(--s-12);
    display: flex;
    flex-direction: column;
    gap: var(--s-6);
  }

  /* ----------------------------------------------------------
     GRID
     ---------------------------------------------------------- */
  .anime-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-3);
  }

  @media (min-width: 50rem) {
    .anime-grid {
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: var(--s-4);
    }
  }

  /* ----------------------------------------------------------
     EMPTY
     ---------------------------------------------------------- */
  .empty {
    color: var(--text-muted);
    text-align: center;
    padding: var(--s-12) 0;
    font-size: var(--fs-sm);
  }
</style>