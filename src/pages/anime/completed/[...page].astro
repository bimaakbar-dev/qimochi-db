---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Page from '~/components/Page.astro';
import Hero from '~/components/Hero.astro';
import AnimeGrid from '~/components/AnimeGrid.astro';
import Pagination from '~/components/Pagination.astro';
import { getStatusData, buildStatusPaths, paginate } from '~/lib/status';

export async function getStaticPaths() {
  const { anime, totalPages } = await getStatusData('complete');
  return buildStatusPaths('complete', anime, totalPages);
}

const { anime, totalPages, pageNumber } = Astro.props;
const items = paginate(anime, pageNumber);
---

<BaseLayout
  title="Anime completed"
  description="Daftar anime yang sudah tamat."
  noindex={pageNumber > 1}
>
  <Page>
    <Hero title="Anime completed" description="Anime yang sudah selesai tayang." />
    <AnimeGrid items={items} emptyText="Belum ada anime yang tamat." />
    <Pagination current={pageNumber} total={totalPages} base="/anime/completed" />
  </Page>
</BaseLayout>