---
import { getCollection, getEntries, getEntry, render } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import Page from '~/components/Page.astro';
import Breadcrumb from '~/components/Breadcrumb.astro';
import SectionLabel from '~/components/SectionLabel.astro';
import Badge from '~/user-components/Badge.astro';
import LinkButton from '~/user-components/LinkButton.astro';
import { RELATION_LABEL, SEASON_LABEL, STATUS_VARIANT, URLS } from '~/constants';
import { formatDate } from '~/lib/blog';

export async function getStaticPaths() {
  const all = await getCollection('anime');
  return all.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);

const [genres, studios] = await Promise.all([getEntries(d.genres), getEntries(d.studios)]);
const franchise = d.franchise ? await getEntry(d.franchise) : undefined;
const relations = (
  await Promise.all(
    d.relations.map(async (r) => ({ type: r.type, entry: await getEntry(r.anime) }))
  )
).filter((r) => r.entry !== undefined);

const dateRange = [
  formatDate(d.releaseDate),
  d.endDate ? formatDate(d.endDate) : d.status === 'Ongoing' ? 'sekarang' : null,
]
  .filter(Boolean)
  .join(' sampai ');
const season = d.season ? ` (${SEASON_LABEL[d.season]} ${d.releaseDate.getUTCFullYear()})` : '';

const rows: [string, string | undefined][] = [
  ['Tipe', d.type],
  ['Episode', d.episodeCount ? String(d.episodeCount) : undefined],
  ['Durasi', d.episodeDuration ? `${d.episodeDuration} menit per episode` : undefined],
  ['Tayang', dateRange + season],
  ['Studio', studios.map((s) => s.data.name).join(', ')],
  ['Diadaptasi dari', d.adaptedFrom],
  ['Rating usia', d.ageRating],
  ['Rating', d.rating !== undefined ? d.rating.toFixed(1) : undefined],
  ['Franchise', franchise?.data.name],
];
const facts = rows.filter((r): r is [string, string] => Boolean(r[1]));

const altTitles = [d.titleEn, d.titleJp, ...d.synonyms].filter(Boolean) as string[];

const externals = [
  d.malId && { label: 'MyAnimeList', href: `https://myanimelist.net/anime/${d.malId}` },
  d.anilistId && { label: 'AniList', href: `https://anilist.co/anime/${d.anilistId}` },
  d.kitsuId && { label: 'Kitsu', href: `https://kitsu.app/anime/${d.kitsuId}` },
].filter(Boolean) as { label: string; href: string }[];

const description = `${d.type} ${d.releaseDate.getUTCFullYear()}, ${genres
  .map((g) => g.data.name)
  .join(', ')}. ${entry.body?.trim().split('\n')[0] ?? ''}`.trim();
---

<BaseLayout title={d.title} description={description} image={d.cover}>
  <Page>
    <Breadcrumb
      items={[
        { label: 'Beranda', href: '/' },
        { label: 'Katalog', href: '/anime/' },
        { label: d.title },
      ]}
    />

    <div class="layout">
      <aside>
        <img class="cover" src={d.cover} alt={`Cover ${d.title}`} width="300" height="450" />
      </aside>

      <article class="main">
        <header class="title-block">
          <div class="badges">
            <Badge variant={STATUS_VARIANT[d.status]}>{d.status}</Badge>
            <Badge variant="outline">{d.type}</Badge>
          </div>
          <h1>{d.title}</h1>
          {altTitles.length > 0 && <p class="alt">{altTitles.join(' / ')}</p>}
        </header>

        <ul class="genres" aria-label="Genre">
          {
            genres.map((g) => (
              <li>
                <a href={URLS.genre(g.id)}>
                  <Badge variant="outline">{g.data.name}</Badge>
                </a>
              </li>
            ))
          }
        </ul>

        <section class="block">
          <SectionLabel as="h2" size="md">Sinopsis</SectionLabel>
          <div class="markdown markdown--prose"><Content /></div>
        </section>

        <section class="block">
          <SectionLabel as="h2" size="md">Informasi</SectionLabel>
          <dl class="facts">
            {
              facts.map(([k, v]) => (
                <div>
                  <dt>{k}</dt>
                  <dd>{v}</dd>
                </div>
              ))
            }
          </dl>
        </section>

        {
          relations.length > 0 && (
            <section class="block">
              <SectionLabel as="h2" size="md">Terkait</SectionLabel>
              <ul class="plain">
                {relations.map((r) => (
                  <li>
                    <span class="rel">{RELATION_LABEL[r.type]}</span>
                    <a href={URLS.anime(r.entry!.id)}>{r.entry!.data.title}</a>
                  </li>
                ))}
              </ul>
            </section>
          )
        }

        {
          d.episodes.length > 0 && (
            <section class="block">
              <SectionLabel as="h2" size="md">Daftar episode</SectionLabel>
              <ol class="episodes">
                {d.episodes.map((ep) => (
                  <li>
                    <span class="num">{ep.number}</span>
                    <span class="ep-title">{ep.title ?? `Episode ${ep.number}`}</span>
                    {ep.airDate && <span class="ep-date">{formatDate(ep.airDate)}</span>}
                  </li>
                ))}
              </ol>
            </section>
          )
        }

        <div class="links">
          {d.trailer && (
            <LinkButton href={d.trailer} variant="gold" size="sm" icon="external" iconPos="suffix" external>
              Trailer
            </LinkButton>
          )}
          {externals.map((x) => (
            <LinkButton href={x.href} variant="outline" size="sm" icon="external" iconPos="suffix" external>
              {x.label}
            </LinkButton>
          ))}
          <LinkButton href={URLS.api(entry.id)} variant="ghost" size="sm">Data JSON</LinkButton>
        </div>
      </article>
    </div>
  </Page>
</BaseLayout>

<style>
  .layout {
    display: grid;
    gap: var(--s-6);
  }

  .cover {
    width: 100%;
    max-width: 14rem;
    aspect-ratio: 2 / 3;
    object-fit: cover;
    background: var(--bg-surface);
  }

  .main {
    display: flex;
    flex-direction: column;
    gap: var(--s-6);
    min-width: 0;
  }

  .badges { display: flex; flex-wrap: wrap; gap: var(--s-2); }
  .title-block { display: flex; flex-direction: column; gap: var(--s-3); align-items: flex-start; }
  h1 { font-size: var(--fs-3xl); overflow-wrap: anywhere; }
  .alt { color: var(--text-secondary); font-size: var(--fs-sm); }

  .genres { display: flex; flex-wrap: wrap; gap: var(--s-2); margin: 0; padding: 0; }
  .genres a:hover :global(.badge) { border-color: var(--accent); color: var(--accent); }

  .block { display: flex; flex-direction: column; gap: var(--s-4); }

  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(12rem, 1fr));
    gap: var(--s-4);
    margin: 0;
  }
  dt { color: var(--text-muted); font-size: var(--fs-xs); font-weight: var(--fw-semibold); }
  dd { margin: 0; font-weight: var(--fw-medium); }

  .plain { display: flex; flex-direction: column; gap: var(--s-2); margin: 0; padding: 0; }
  .rel { margin-right: var(--s-3); color: var(--text-muted); font-size: var(--fs-xs); }
  .plain a { color: var(--accent); font-weight: var(--fw-medium); }

  .episodes { display: flex; flex-direction: column; margin: 0; padding: 0; }
  .episodes li {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: var(--s-1) var(--s-3);
    padding: var(--s-2) 0;
    border-bottom: 1px solid var(--border);
    font-size: var(--fs-sm);
  }
  .num { color: var(--text-muted); font-variant-numeric: tabular-nums; }
  .ep-date { grid-column: 2; color: var(--text-muted); font-size: var(--fs-xs); }

  .links { display: flex; flex-wrap: wrap; gap: var(--s-2); }

  @media (min-width: 50rem) {
    .layout { grid-template-columns: 14rem 1fr; gap: var(--s-10); }
    aside { position: sticky; top: var(--sticky-top); align-self: start; }
    h1 { font-size: var(--fs-4xl); }
  }
</style>