
---
import { render } from 'astro:content';
import { getCollection } from 'astro:content';
import { getAllAnime } from '~/lib/anime';

import BaseLayout from '~/layouts/BaseLayout.astro';
import Page from '~/components/Page.astro';
import AnimeBanner from '~/components/AnimeBanner.astro';
import AnimeDetailLayout from '~/components/AnimeDetailLayout.astro';
import AnimeCover from '~/components/AnimeCover.astro';
import AnimeRating from '~/components/AnimeRating.astro';
import AnimeTabs from '~/components/AnimeTabs.astro';
import AnimeMeta from '~/components/AnimeMeta.astro';
import AnimeSummary from '~/components/AnimeSummary.astro';
import AnimeFranchise from '~/components/AnimeFranchise.astro';
import AnimeEpisodes from '~/components/AnimeEpisodes.astro';
import AnimeCharacters from '~/components/AnimeCharacters.astro';
import AnimeTrailer from '~/components/AnimeTrailer.astro';

export async function getStaticPaths() {
  const allAnime = await getAllAnime();
  return allAnime.map((anime) => ({
    params: { slug: anime.id },
    props: { anime },
  }));
}

const { anime } = Astro.props;
const { data } = anime;
const { Content } = await render(anime);

const allStudios = await getCollection('studios');
const studioMap = new Map(allStudios.map((s) => [s.data.id, s.data.name]));

const studioItems = data.studios.map((slug) => ({
  slug,
  name: studioMap.get(slug) ?? slug,
}));
---

<BaseLayout title={data.title}>
  <AnimeBanner image={data.banner} />
  <Page>
    <AnimeDetailLayout>
      <AnimeCover slot="cover" image={data.image} title={data.title}>
        <AnimeRating
          slot="action"
          animeId={anime.id}
          malScore={data.stats?.score}
          malVotes={data.stats?.scoredBy}
        />
      </AnimeCover>

      <AnimeTabs>
        <AnimeSummary
          slot="summary"
          title={data.title}
          year={data.year}
          genres={data.genres}
        >
          <div class="markdown">
            <Content />
          </div>
        </AnimeSummary>

        <AnimeEpisodes slot="episodes" episodes={data.episodeList} />

        <AnimeCharacters slot="characters" characters={data.characters} />

        <AnimeFranchise
          slot="franchise"
          title={data.title}
          franchises={data.franchises}
        />
      </AnimeTabs>

      <div slot="meta" class="detail-sidebar">
        <AnimeTrailer trailer={data.trailer} title={data.title} />

        <AnimeMeta
          title={data.title}
          titleEnglish={data.titleEnglish}
          titleNative={data.titleNative}
          type={data.type}
          status={data.status}
          source={data.source}
          season={data.season}
          year={data.year}
          episodes={data.episodes}
          duration={data.duration}
          rating={data.rating}
          aired={data.aired}
          studios={studioItems}
          malId={data.malId}
          anilistId={data.anilistId}
          kitsuId={data.kitsuId}
        />
      </div>
    </AnimeDetailLayout>
  </Page>
</BaseLayout>

<style>
  .detail-sidebar {
    display: flex;
    flex-direction: column;
    gap: var(--s-5);
  }
</style>
