---
import { getCollection, render } from 'astro:content';
import { SITE, URLS, STATUS_VARIANT, type Status } from '~/constants';
import BaseLayout from '~/layouts/BaseLayout.astro';
import Badge from '~/user-components/Badge.astro';

export async function getStaticPaths() {
  const allAnime = await getCollection('anime');
  return allAnime.map(anime => ({
    params: { slug: anime.id },
    props: { anime },
  }));
}

const { anime } = Astro.props;
const { data } = anime;
const { Content } = await render(anime);

const sortedEpisodes = [...data.episodes].sort((a, b) => a.number - b.number);
const statusVariant = STATUS_VARIANT[data.status as Status] ?? 'default';

const releaseDate = new Intl.DateTimeFormat(SITE.locale, {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
}).format(data.releaseDate);

const year = data.releaseDate.getFullYear();
const updatedDate = data.updatedAt
  ? new Intl.DateTimeFormat(SITE.locale, {
      day: 'numeric',
      month: 'long',
      year: 'numeric',
    }).format(data.updatedAt)
  : null;
---

<BaseLayout
  title={data.title}
  description={`${data.title} — informasi lengkap, sinopsis, dan daftar episode. ${data.studio}, ${year}.`}
  image={data.cover}
  type="article"
>
  <article>
    <section class="hero">
      <div class="cover">
        <img
          src={data.cover}
          alt={`Cover ${data.title}`}
          width="200"
          height="300"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </div>

      <div class="hero-info">
        <Badge variant={statusVariant} size="md">{data.status}</Badge>

        <h1>{data.title}</h1>

        {data.titleJp && (
          <p class="title-alt">{data.titleJp}</p>
        )}

        <dl class="hero-meta">
          <div class="meta-item">
            <dt>Tipe</dt>
            <dd>{data.type}</dd>
          </div>
          <div class="meta-item">
            <dt>Rating</dt>
            <dd>{data.rating} / 10</dd>
          </div>
          <div class="meta-item">
            <dt>Episode</dt>
            <dd>{data.episodes.length || '—'}</dd>
          </div>
          <div class="meta-item">
            <dt>Rilis</dt>
            <dd>{releaseDate}</dd>
          </div>
          <div class="meta-item">
            <dt>Studio</dt>
            <dd>{data.studio}</dd>
          </div>
          <div class="meta-item">
            <dt>Genre</dt>
            <dd class="genre-list">
              {data.genre.map((g, i) => (
                <>
                  <a href={URLS.genre(g)}>{g}</a>
                  {i < data.genre.length - 1 && ', '}
                </>
              ))}
            </dd>
          </div>
        </dl>

        {(data.malId || data.anilistId) && (
          <div class="external-links">
            {data.malId && (
              <a
                href={`https://myanimelist.net/anime/${data.malId}`}
                target="_blank"
                rel="noopener noreferrer"
                class="ext-link"
              >
                MyAnimeList ↗
              </a>
            )}
            {data.anilistId && (
              <a
                href={`https://anilist.co/anime/${data.anilistId}`}
                target="_blank"
                rel="noopener noreferrer"
                class="ext-link"
              >
                AniList ↗
              </a>
            )}
          </div>
        )}
      </div>
    </section>

    <div class="content-grid">
      <div class="content-main">
        <section class="synopsis-section">
          <h2 class="section-title">Sinopsis</h2>
          <div class="markdown markdown--prose">
            <Content />
          </div>
        </section>

        {sortedEpisodes.length > 0 && (
          <section class="episodes-section">
            <h2 class="section-title">Daftar Episode</h2>
            <ol class="episode-list">
              {sortedEpisodes.map(ep => (
                <li class="episode-item">
                  <span class="ep-number">Ep {ep.number}</span>
                  {ep.title && <span class="ep-title">{ep.title}</span>}
                  {ep.airDate && (
                    <span class="ep-date">
                      {new Intl.DateTimeFormat(SITE.locale, {
                        day: 'numeric',
                        month: 'short',
                        year: 'numeric',
                      }).format(ep.airDate)}
                    </span>
                  )}
                </li>
              ))}
            </ol>
          </section>
        )}
      </div>

      <aside class="content-aside">
        <div class="meta-card">
          <h3 class="aside-title">Info</h3>
          <dl class="aside-meta">
            <div>
              <dt>Slug</dt>
              <dd><code>{anime.id}</code></dd>
            </div>
            {data.source && (
              <div>
                <dt>Sumber Data</dt>
                <dd>{data.source}</dd>
              </div>
            )}
            {updatedDate && (
              <div>
                <dt>Update Terakhir</dt>
                <dd>{updatedDate}</dd>
              </div>
            )}
          </dl>
        </div>
      </aside>
    </div>
  </article>
</BaseLayout>

<style>
  article {
    max-width: var(--content-max-mobile);
    margin-inline: auto;
    padding-block: var(--s-6) var(--s-12);
    padding-inline: var(--pad-x);
    isolation: isolate;
  }

  .hero {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s-5);
    background: var(--bg-elevated);
    padding: var(--s-5);
    margin-bottom: var(--s-6);
    text-align: center;
    align-items: center;
    justify-items: center;
  }

  .cover {
    width: 100%;
    max-width: 200px;
  }

  .cover img {
    width: 100%;
    height: auto;
    aspect-ratio: 2 / 3;
    object-fit: cover;
    display: block;
  }

  .hero-info {
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
    align-items: center;
    width: 100%;

    & h1 {
      font-size: var(--fs-3xl);
      line-height: var(--lh-tight);
      font-weight: var(--fw-bold);
      margin: 0;
      color: var(--text-primary);
    }

    & .title-alt {
      margin: 0;
      color: var(--text-muted);
      font-size: var(--fs-sm);
    }

    & .hero-meta {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: var(--s-4);
      width: 100%;
      margin: 0;
      text-align: center;
      justify-items: center;

      & .meta-item {
        display: flex;
        flex-direction: column;
        gap: var(--s-1);
        align-items: center;
        min-width: 0;
      }

      & dt {
        font-size: var(--fs-xs);
        font-weight: var(--fw-semibold);
        color: var(--text-muted);
        text-transform: uppercase;
        letter-spacing: 0.08em;
      }

      & dd {
        font-size: var(--fs-sm);
        color: var(--text-primary);
        margin: 0;
        line-height: var(--lh-relaxed);
        min-width: 0;
        overflow-wrap: anywhere;
      }
    }
  }

  .genre-list {
    & a {
      position: relative;
      color: var(--accent);
      transition: color var(--t-fast);
      &::after {
        content: '';
        position: absolute;
        left: -3%;
        right: -3%;
        bottom: -0.1em;
        height: 0.45em;
        background-color: var(--accent);
        -webkit-mask-image: var(--underline);
        mask-image: var(--underline);
        -webkit-mask-size: 100% 100%;
        mask-size: 100% 100%;
        -webkit-mask-repeat: no-repeat;
        mask-repeat: no-repeat;
        pointer-events: none;
        opacity: 0;
        transition: opacity var(--t-fast);
      }
      &:hover {
        color: var(--accent-hover);
        &::after {
          opacity: 1;
        }
      }
    }
  }

  .external-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    justify-content: center;
    width: 100%;

    .ext-link {
      display: inline-flex;
      align-items: center;
      padding: var(--s-2) var(--s-4);
      background: var(--bg-surface);
      border: 1px solid var(--border);
      font-size: var(--fs-xs);
      font-weight: var(--fw-semibold);
      color: var(--text-secondary);
      transition: all var(--t-fast);

      &:hover {
        border-color: var(--accent);
        color: var(--accent);
      }
    }
  }

  .content-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s-6);
    align-items: start;
  }

  .content-main {
    min-width: 0;
  }

  .section-title {
    font-size: var(--fs-lg);
    margin: 0 0 var(--s-3);
    color: var(--text-primary);
  }

  .episodes-section {
    margin-top: var(--s-8);
  }

  .episode-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--s-1);
  }

  .episode-item {
    display: flex;
    align-items: baseline;
    gap: var(--s-3);
    padding: var(--s-3) var(--s-4);
    background: var(--bg-surface);
    border: 1px solid var(--border);
    transition: all var(--t-fast);

    &:hover {
      border-color: var(--accent);
    }
  }

  .ep-number {
    font-weight: var(--fw-semibold);
    color: var(--accent);
    font-size: var(--fs-sm);
    flex-shrink: 0;
  }

  .ep-title {
    color: var(--text-primary);
    font-size: var(--fs-sm);
    flex: 1;
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .ep-date {
    color: var(--text-muted);
    font-size: var(--fs-xs);
    flex-shrink: 0;
  }

  .meta-card {
    background: var(--bg-surface);
    border: 1px solid var(--border);
    padding: var(--s-4);
  }

  .aside-title {
    font-size: var(--fs-sm);
    font-weight: var(--fw-semibold);
    color: var(--text-primary);
    margin: 0 0 var(--s-3);
    padding-bottom: var(--s-2);
    border-bottom: 1px solid var(--border);
  }

  .aside-meta {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    margin: 0;

    & > div {
      display: flex;
      flex-direction: column;
      gap: var(--s-1);
    }

    & dt {
      font-size: var(--fs-xs);
      font-weight: var(--fw-semibold);
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }

    & dd {
      font-size: var(--fs-sm);
      color: var(--text-primary);
      margin: 0;
      overflow-wrap: anywhere;

      & code {
        font-family: var(--font-firaCode);
        font-size: var(--fs-xs);
        background: var(--bg-elevated);
        padding: 0.15em 0.4em;
      }
    }
  }

  @media (min-width: 50rem) {
    article {
      max-width: var(--content-max-desktop);
    }

    .hero {
      grid-template-columns: 200px 1fr;
      gap: var(--s-6);
      padding: var(--s-6);
      text-align: start;
      justify-items: start;
    }

    .cover {
      max-width: none;
    }

    .hero-info {
      align-items: flex-start;

      & .hero-meta {
        grid-template-columns: repeat(3, 1fr);
        gap: var(--s-4) var(--s-6);
        text-align: start;
        justify-items: start;

        & .meta-item {
          align-items: flex-start;
        }
      }
    }

    .external-links {
      justify-content: flex-start;
    }

    .content-grid {
      grid-template-columns: 1fr var(--aside-width);
    }

    .content-aside {
      position: sticky;
      top: var(--sticky-top);
      max-height: calc(100vh - var(--sticky-top) - var(--s-4));
      overflow-y: auto;
    }
  }
</style>