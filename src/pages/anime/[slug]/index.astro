---
import { getCollection, render } from 'astro:content';
import { SITE, URLS, STATUS_VARIANT, type Status } from '~/constants';
import BaseLayout from '~/layouts/BaseLayout.astro';
import EpisodeList from '~/components/EpisodeList.astro';
import Badge from '~/user-components/Badge.astro';
import LinkButton from '~/user-components/LinkButton.astro';

export async function getStaticPaths() {
  const allAnime = await getCollection('anime');
  return allAnime.map(anime => ({
    params: { slug: anime.id },
    props: { anime },
  }));
}

const { anime } = Astro.props;
const { data } = anime;
const { Content } = await render(anime);

const episodeNumbers = data.episodes
  .map(e => e.number)
  .sort((a, b) => a - b);

const firstEpisode = episodeNumbers[0] ?? 1;
const statusVariant = STATUS_VARIANT[data.status as Status] ?? 'default';

const releaseDate = new Intl.DateTimeFormat(SITE.locale, {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
}).format(data.releaseDate);

const year = data.releaseDate.getFullYear();
---

<BaseLayout
  title={data.title}
  description={`Nonton dan download ${data.title} batch. ${data.studio}, ${year}.`}
  image={data.cover}
  type="video.other"
>
  <article>
    <section class="hero">
      <div class="cover">
        <img
          src={data.cover}
          alt={`Cover ${data.title}`}
          width="200"
          height="300"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </div>

      <div class="hero-info">
        <Badge variant={statusVariant} size="md">{data.status}</Badge>

        <h1>{data.title}</h1>

        <dl class="hero-meta">
          <div class="meta-item">
            <dt>Tipe</dt>
            <dd>{data.type}</dd>
          </div>
          <div class="meta-item">
            <dt>Rating</dt>
            <dd>{data.rating} / 10</dd>
          </div>
          <div class="meta-item">
            <dt>Episode</dt>
            <dd>{data.episodes.length}</dd>
          </div>
          <div class="meta-item">
            <dt>Rilis</dt>
            <dd>{releaseDate}</dd>
          </div>
          <div class="meta-item">
            <dt>Studio</dt>
            <dd>{data.studio}</dd>
          </div>
          <div class="meta-item">
            <dt>Genre</dt>
            <dd class="genre-list">
              {data.genre.map((g, i) => (
                <>
                  <a href={URLS.genre(g)}>{g}</a>
                  {i < data.genre.length - 1 && ', '}
                </>
              ))}
            </dd>
          </div>
        </dl>

        <LinkButton
          href={URLS.watch(anime.id, firstEpisode)}
          variant="accent"
          size="lg"
          icon="play"
        >
          Mulai dari Episode {firstEpisode}
        </LinkButton>
      </div>
    </section>

    <div class="content-grid">
      <div class="content-main">
        <section class="synopsis-section">
          <h2 class="section-title">Sinopsis</h2>
          <div class="markdown markdown--prose">
            <Content />
          </div>
        </section>
      </div>

      <aside class="content-aside">
        <EpisodeList
          slug={anime.id}
          episodes={episodeNumbers}
          currentEpisode={null}
        />
      </aside>
    </div>
  </article>
</BaseLayout>

<style>
  article {
    max-width: var(--content-max-mobile);
    margin-inline: auto;
    padding-block: var(--s-6) var(--s-12);
    padding-inline: var(--pad-x);
    isolation: isolate;
  }

  .hero {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s-5);
    background: var(--bg-elevated);
    padding: var(--s-5);
    margin-bottom: var(--s-6);
    text-align: center;
    align-items: center;
    justify-items: center;
  }

  .cover {
    width: 100%;
    max-width: 200px;
  }

  .cover img {
    width: 100%;
    height: auto;
    aspect-ratio: 2 / 3;
    object-fit: cover;
    display: block;
  }

  .hero-info {
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
    align-items: center;
    width: 100%;

    & h1 {
      font-size: var(--fs-3xl);
      line-height: var(--lh-tight);
      font-weight: var(--fw-bold);
      margin: 0;
      color: var(--text-primary);
    }

    & .hero-meta {
      display: grid;
      /* Mobile: 2 kolom × 3 baris */
      grid-template-columns: repeat(2, 1fr);
      gap: var(--s-4);
      width: 100%;
      margin: 0;
      text-align: center;
      justify-items: center;

      & .meta-item {
        display: flex;
        flex-direction: column;
        gap: var(--s-1);
        align-items: center;
        min-width: 0;
      }

      & dt {
        font-size: var(--fs-xs);
        font-weight: var(--fw-semibold);
        color: var(--text-muted);
        text-transform: uppercase;
        letter-spacing: 0.08em;
      }

      & dd {
        font-size: var(--fs-sm);
        color: var(--text-primary);
        margin: 0;
        line-height: var(--lh-relaxed);
        min-width: 0;
        overflow-wrap: anywhere;
      }
    }
  }
  .genre-list {
    & a {
      position: relative;
      color: var(--accent);
      transition: color var(--t-fast);
      &::after {
        content: '';
        position: absolute;
        left: -3%;
        right: -3%;
        bottom: -0.1em;
        height: 0.45em;
        background-color: var(--accent);
        -webkit-mask-image: var(--underline);
        mask-image: var(--underline);
        -webkit-mask-size: 100% 100%;
        mask-size: 100% 100%;
        -webkit-mask-repeat: no-repeat;
        mask-repeat: no-repeat;
        pointer-events: none;
        opacity: 0;
        transition: opacity var(--t-fast);
      }
      &:hover {
        color: var(--accent-hover);
        &::after {
          opacity: 1;
        }
      }
    }
  }
  .content-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s-6);
    align-items: start;
  }
  .content-main {
    min-width: 0;
  }
  .section-title {
    font-size: var(--fs-lg);
    margin: 0 0 var(--s-3);
    color: var(--text-primary);
  }

  @media (min-width: 50rem) {
    article {
      max-width: var(--content-max-desktop);
    }
    .hero {
      grid-template-columns: 200px 1fr;
      gap: var(--s-6);
      padding: var(--s-6);
      text-align: start;
      justify-items: start;
    }
    .cover {
      max-width: none;
    }
    .hero-info {
      align-items: flex-start;
      & .hero-meta {
        grid-template-columns: repeat(3, 1fr);
        gap: var(--s-4) var(--s-6);
        text-align: start;
        justify-items: start;

        & .meta-item {
          align-items: flex-start;
        }
      }
    }

    .content-grid {
      grid-template-columns: 1fr var(--aside-width);
    }

    .content-aside {
      position: sticky;
      top: var(--sticky-top);
      max-height: calc(100vh - var(--sticky-top) - var(--s-4));
      overflow-y: auto;
    }
  }
</style>