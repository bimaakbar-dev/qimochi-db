---
interface Props {
  as?: 'h1' | 'h2' | 'h3' | 'h4' | 'hero';
  size?: 'sm' | 'md' | 'lg';
  underlined?: boolean;
  class?: string;
}

const {
  as: Tag = 'h2',
  size = 'lg',
  underlined = true,
  class: className,
} = Astro.props;
---

<Tag
  class:list={[
    'section-label',
    `section-label-${size}`,
  ]}
>
  <span
    class:list={[
      'section-label__text',
      { 'section-label__text--underlined': underlined },
      className,
    ]}
  >
    <slot />
  </span>
</Tag>

<style>
  .section-label {
    letter-spacing: 0.1em;
    font-weight: var(--fw-semibold);
    margin: 0;
  }

  .section-label__text {
    display: inline-block;
    position: relative;
    color: var(--text-primary);
  }

  .section-label-sm { font-size: var(--fs-xs); }
  .section-label-md { font-size: var(--fs-lg); }
  .section-label-lg { font-size: var(--fs-xl); }
  .section-label-hero { font-size: var(--fs-3xl); }

  :global(.section-label__text--underlined::after) {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.2em;
    height: 0.45em;
    background-color: var(--accent);

    -webkit-mask-image: var(--underline);
    mask-image: var(--underline);
    -webkit-mask-size: 100% 100%;
    mask-size: 100% 100%;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;

    pointer-events: none;
  }
  @media (min-width: 50rem) {
    .section-label-hero { font-size: var(--fs-5xl); }
  }
</style>