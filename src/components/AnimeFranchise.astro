---
import { getCollection } from 'astro:content';
import EmptyState from '~/components/EmptyState.astro';
import Badge from '~/user-components/Badge.astro';
import { URLS, RELATION_LABEL, type RelationType } from '~/constants';

interface Props {
  title: string;
  franchises?: { relation: string; slug: string; title?: string }[];
}

const { title, franchises = [] } = Astro.props;

const allAnime = await getCollection('anime');
const animeMap = new Map(allAnime.map((a) => [a.id, a]));

function slugToTitle(slug: string): string {
  return slug
    .split('-')
    .map((w) => w.charAt(0).toUpperCase() + w.slice(1))
    .join(' ');
}

const items = franchises.map((rel) => {
  const anime = animeMap.get(rel.slug) ?? null;

  let displayTitle: string;
  if (anime) {
    displayTitle = anime.data.title;
  } else if (rel.title) {
    displayTitle = rel.title;
  } else {
    displayTitle = slugToTitle(rel.slug);
  }

  return {
    relation: rel.relation,
    relationLabel: RELATION_LABEL[rel.relation as RelationType] ?? rel.relation,
    slug: rel.slug,
    anime,
    displayTitle,
  };
});
---

<div class="anime-franchise">
  <header class="anime-franchise__header">
    <h2 class="anime-franchise__title">{title} Franchise</h2>
  </header>

  {items.length === 0 ? (
    <EmptyState
      title="Belum ada data franchise"
      message="Data franchise belum tersedia untuk anime ini."
    />
  ) : (
    <div class="anime-franchise__grid">
      {items.map((item) =>
        item.anime ? (
          <a href={URLS.anime(item.slug)} class="related-card">
            <div class="related-card__cover">
              {item.anime.data.image ? (
                <img
                  src={item.anime.data.image}
                  alt=""
                  loading="lazy"
                />
              ) : (
                <div class="related-card__placeholder" />
              )}
            </div>
            <div class="related-card__body">
              <Badge variant="outline" size="sm">
                {item.relationLabel}
              </Badge>
              <p class="related-card__title">
                {item.anime.data.title}
              </p>
              <p class="related-card__meta">
                {item.anime.data.year ?? '—'}
              </p>
            </div>
          </a>
        ) : (
          <div class="related-card related-card--disabled">
            <div class="related-card__cover">
              <div class="related-card__placeholder" />
            </div>
            <div class="related-card__body">
              <Badge variant="outline" size="sm">
                {item.relationLabel}
              </Badge>
              <p class="related-card__title">{item.displayTitle}</p>
              <p class="related-card__meta">Belum tersedia</p>
            </div>
          </div>
        )
      )}
    </div>
  )}
</div>

<style>
  .anime-franchise {
    display: flex;
    flex-direction: column;
    gap: var(--s-5);
  }

  .anime-franchise__header {
    display: flex;
    flex-direction: column;
    gap: var(--s-1);
  }

  .anime-franchise__title {
    margin: 0;
    font-size: var(--fs-2xl);
    font-weight: var(--fw-bold);
    line-height: var(--lh-tight);
    color: var(--text-primary);
  }

  .anime-franchise__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--s-3);
  }

  @media (min-width: 50rem) {
    .anime-franchise__grid {
      grid-template-columns: repeat(4, 1fr);
      gap: var(--s-4);
    }
  }

  .related-card {
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
    text-decoration: none;
    color: inherit;
    transition: transform var(--t-fast);
  }

  .related-card:not(.related-card--disabled):hover {
    transform: translateY(-2px);
  }

  .related-card--disabled {
    opacity: 0.6;
    cursor: default;
  }

  .related-card__cover {
    position: relative;
    aspect-ratio: 2 / 3;
    border-radius: var(--r-sm);
    overflow: hidden;
    background: var(--bg-surface);
  }

  .related-card__cover img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .related-card__placeholder {
    width: 100%;
    height: 100%;
    background: var(--bg-surface);
  }

  .related-card__body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--s-1);
  }

  .related-card__title {
    margin: 0;
    font-size: var(--fs-xs);
    font-weight: var(--fw-medium);
    color: var(--text-primary);
    line-height: 1.3;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .related-card__meta {
    margin: 0;
    font-size: 0.6875rem;
    color: var(--text-muted);
  }
</style>