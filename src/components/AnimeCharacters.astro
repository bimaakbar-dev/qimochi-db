---
import EmptyState from '~/components/EmptyState.astro';

interface Props {
  characters?: {
    name: string;
    nameNative?: string;
    image?: string;
    role: 'main' | 'supporting' | 'background';
    voiceActors?: {
      name: string;
      image?: string;
      language?: string;
    }[];
  }[];
}

const { characters = [] } = Astro.props;
---

<div class="anime-characters">
  {characters.length === 0 ? (
    <EmptyState
      title="Belum ada data karakter"
      message="Data karakter belum tersedia untuk anime ini."
    />
  ) : (
    <ul class="anime-characters__list">
      {characters.map((char) => {
        const va = char.voiceActors?.[0];

        return (
          <li class="character-row">
            <div class="character-row__char">
              <div class="character-row__char-cover">
                {char.image ? (
                  <img src={char.image} alt="" loading="lazy" />
                ) : (
                  <div class="cover-placeholder" />
                )}
              </div>
              <div class="character-row__char-info">
                <p class="character-row__name">{char.name}</p>
                {char.nameNative && (
                  <p class="character-row__name-native">
                    {char.nameNative}
                  </p>
                )}
                <p class="character-row__name-native">{char.role}</p>
              </div>
            </div>

            {va && (
              <div class="character-row__va">
                <div class="character-row__va-cover">
                  {va.image ? (
                    <img src={va.image} alt="" loading="lazy" />
                  ) : (
                    <div class="cover-placeholder" />
                  )}
                </div>
                <p class="character-row__va-name">{va.name}</p>
              </div>
            )}
          </li>
        );
      })}
    </ul>
  )}
</div>

<style>
  .anime-characters {
    display: flex;
    flex-direction: column;
  }

  .anime-characters__list {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .character-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
    padding: var(--s-3) 0;
    border-bottom: 1px solid var(--border);
  }

  .character-row:last-child {
    border-bottom: none;
  }
  .character-row__char {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    min-width: 0;
    flex: 1;
  }

  .character-row__char-cover {
    flex-shrink: 0;
    width: 3rem;
    aspect-ratio: 2 / 3;
    border-radius: var(--r-sm);
    overflow: hidden;
    background: var(--bg-surface);
  }

  .character-row__char-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .character-row__name {
    margin: 0;
    font-size: var(--fs-sm);
    font-weight: var(--fw-medium);
    color: var(--text-primary);
    line-height: 1.3;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .character-row__name-native {
    margin: 0;
    font-size: var(--fs-xs);
    color: var(--text-muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .character-row__va {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    flex-shrink: 0;
  }

  .character-row__va-cover {
    flex-shrink: 0;
    width: 2.25rem;
    aspect-ratio: 1 / 1;
    border-radius: var(--r-full);
    overflow: hidden;
    background: var(--bg-surface);
  }

  .character-row__va-name {
    margin: 0;
    font-size: var(--fs-xs);
    color: var(--text-secondary);
    text-align: right;
    line-height: 1.3;
    max-width: 8rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .character-row__char-cover img,
  .character-row__va-cover img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cover-placeholder {
    width: 100%;
    height: 100%;
    background: var(--bg-surface);
  }

  @media (max-width: 50rem) {
    .character-row {
      flex-direction: column;
      align-items: stretch;
    }

    .character-row__va {
      justify-content: flex-end;
    }

    .character-row__va-name {
      max-width: none;
    }
  }
</style>
