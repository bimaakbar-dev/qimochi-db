---
interface Props {
  src: string;
  title: string;
}

const { src, title } = Astro.props;
---

<div class="player-wrapper">
  {src ? (
    <iframe
      id="player-iframe"
      src={src}
      title={title}
      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; fullscreen"
      allowfullscreen
      loading="eager"
      referrerpolicy="no-referrer"
    ></iframe>
  ) : (
    <div class="player-empty">
      <p>Video belum tersedia.</p>
    </div>
  )}
</div>

<style>
  .player-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    background: #000;
    border: 1px solid var(--border);
    overflow: hidden;
  }

  .player-wrapper iframe {
    width: 100%;
    height: 100%;
    border: none;
    display: block;
  }

  .player-empty {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    color: var(--text-muted);
    font-size: var(--fs-sm);
  }
</style>