---
import { URLS } from '~/constants';
import { escapeHtml } from '~/lib/utils';

interface Props {
  mode?: 'card' | 'template';
  slug?: string;
  title?: string;
  image?: string;
}

const { mode = 'card', slug = '', title = '', image } = Astro.props;

function cardMarkup(opts: {
  href?: string;
  title?: string;
  image?: string;
}): string {
  const { href = '', title = '', image } = opts;
  const hasImage = Boolean(image);
  const safeTitle = escapeHtml(title);
  const safeHref = escapeHtml(href);
  const safeImage = image ? escapeHtml(image) : '';

  return `
<article class="anime-card">
  <a${safeHref ? ` href="${safeHref}"` : ''} class="anime-card__link"${safeTitle ? ` aria-label="${safeTitle}"` : ''}>
    <div class="anime-card__cover">
      <img${safeImage ? ` src="${safeImage}"` : ''} alt="" loading="lazy" decoding="async" width="300" height="450" class="anime-card__img"${hasImage ? '' : ' hidden'} />
      <div class="anime-card__placeholder" aria-hidden="true"${hasImage ? ' hidden' : ''}></div>
      <div class="anime-card__overlay">
        <h3 class="anime-card__title">${safeTitle}</h3>
      </div>
    </div>
  </a>
</article>`.trim();
}

const isTemplate = mode === 'template';

const html = isTemplate
  ? cardMarkup({})
  : cardMarkup({ href: URLS.anime(slug), title, image });
---

{isTemplate ? (
  <template id="anime-card-template" set:html={html} />
) : (
  <Fragment set:html={html} />
)}

<style is:global>
  .anime-card__link {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .anime-card__cover {
    position: relative;
    aspect-ratio: 2 / 3;
    overflow: hidden;
    background: var(--bg-surface);
  }

  .anime-card__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity var(--t-base);
  }

  .anime-card__img[data-loading] {
    opacity: 0;
  }

  .anime-card__placeholder {
    width: 100%;
    height: 100%;
    background: var(--bg-surface);
  }

  .anime-card__overlay {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: var(--s-4);
    background: hsla(30, 3%, 5%, 0.5);
    opacity: 1;
    transition: opacity var(--t-base), background-color var(--t-base);
  }

  .anime-card__title {
    margin: 0;
    font-size: var(--fs-xs);
    font-weight: var(--fw-semibold);
    line-height: var(--lh-tight);
    color: var(--text-inverted);
    text-align: center;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (min-width: 50rem) {
    .anime-card__title {
      font-size: var(--fs-sm);
    }
  }

  @media (hover: hover) and (pointer: fine) {
    .anime-card__overlay {
      opacity: 0;
      background: hsla(30, 3%, 5%, 0.7);
    }
    .anime-card__link:hover .anime-card__overlay,
    .anime-card__link:focus-visible .anime-card__overlay {
      opacity: 1;
    }
  }
</style>