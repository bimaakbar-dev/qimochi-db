---
import Icon from '~/user-components/Icons.astro';

interface Server {
  name: string;
  url: string;
}
interface Download {
  quality: string;
  size: string;
  servers: Server[];
}

interface Props {
  downloads: Download[];
}

const { downloads } = Astro.props;

if (!downloads || downloads.length === 0) return null;
---

<section class="download-panel">
  <h3 class="panel-title">Download</h3>

  {downloads.map((d) => (
    <details class="quality-item">
      <summary>
        <span class="quality">{d.quality}</span>
        <span class="size">· {d.size}</span>
        <span class="chevron" aria-hidden="true">
          <Icon name="chevron-down" size={14} />
        </span>
      </summary>
      <div class="servers">
        {d.servers.map(srv => (
          <a
            href={srv.url}
            target="_blank"
            rel="noopener noreferrer nofollowb"
            class="dl-link"
          >
            <Icon name="download" />
            {srv.name}
          </a>
        ))}
      </div>
    </details>
  ))}
</section>

<style>
  .download-panel {
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    padding: var(--s-4);
  }

  .panel-title {
    font-size: var(--fs-base);
    font-weight: var(--fw-semibold);
    margin: 0 0 var(--s-3);
    color: var(--text-primary);
  }

  .quality-item {
    border-top: 1px solid var(--border);
  }

  .quality-item:first-of-type {
    border-top: none;
  }

  .quality-item summary {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    padding: var(--s-3) 0;
    cursor: pointer;
    list-style: none;
    font-size: var(--fs-sm);
    user-select: none;
  }

  .quality-item summary::-webkit-details-marker { display: none; }

  .quality {
    font-weight: var(--fw-semibold);
    color: var(--text-primary);
  }

  .size {
    color: var(--text-muted);
  }

  .chevron {
    display: inline-flex;
    align-items: center;
    margin-left: auto;
    color: var(--text-muted);
    transition: transform var(--t-base);
  }

  .quality-item[open] .chevron {
    transform: rotate(180deg);
  }

  .servers {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    padding: 0 0 var(--s-3) 0;
  }

  .dl-link {
    display: inline-flex;
    align-items: center;
    gap: var(--s-1);
    padding: var(--s-1) var(--s-3);
    background: var(--bg-surface);
    border: 1px solid var(--border);
    font-size: var(--fs-xs);
    font-weight: var(--fw-medium);
    color: var(--text-secondary);
    transition: all var(--t-fast);
  }

  .dl-link:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .dl-link :global(svg) {
    width: 0.9em;
    height: 0.9em;
  }
</style>