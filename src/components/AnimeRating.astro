---
interface Props {
  animeId: string;
  malScore?: number;
  malVotes?: number;
}

const { animeId, malScore, malVotes } = Astro.props;
const hasMal = malScore != null && malVotes != null;
---

<div class="anime-rating" data-anime-rating data-anime-id={animeId}>
  <div class="anime-rating__row">
    <div class="anime-rating__stars" data-stars role="group" aria-label="Rating 1-5 bintang">
      <button type="button" data-score-value="1" aria-label="1 bintang">★</button>
      <button type="button" data-score-value="2" aria-label="2 bintang">★</button>
      <button type="button" data-score-value="3" aria-label="3 bintang">★</button>
      <button type="button" data-score-value="4" aria-label="4 bintang">★</button>
      <button type="button" data-score-value="5" aria-label="5 bintang">★</button>
    </div>

    <button
      type="button"
      class="anime-rating__score"
      data-score-btn
      aria-label="Ubah rating kamu"
    >
      <span data-score>{hasMal ? malScore.toFixed(1) : '—'}</span>
      <small>/ 10</small>
    </button>
  </div>

  <p class="anime-rating__votes" data-votes>
    {hasMal ? `${malVotes.toLocaleString('id-ID')} votes` : ''}
  </p>
</div>

<script>
  const API_BASE = 'https://qimochi-api.bimaakbar.workers.dev';

  document.querySelectorAll<HTMLElement>('[data-anime-rating]').forEach((el) => {
    const animeId = el.dataset.animeId!;
    const starsEl = el.querySelector<HTMLElement>('[data-stars]')!;
    const scoreBtnEl = el.querySelector<HTMLButtonElement>('[data-score-btn]')!;
    const scoreEl = el.querySelector<HTMLElement>('[data-score]')!;
    const votesEl = el.querySelector<HTMLElement>('[data-votes]')!;

    const STORAGE_KEY = `qimochi:rating:${animeId}`;

    function highlightStars(count: number) {
      starsEl.querySelectorAll<HTMLButtonElement>('[data-score-value]').forEach((btn) => {
        const value = Number(btn.dataset.scoreValue);
        btn.classList.toggle('is-active', value <= count);
      });
    }

    function showStars(prefill = 0) {
      starsEl.hidden = false;
      scoreBtnEl.classList.remove('is-clickable');
      if (prefill > 0) highlightStars(prefill);
    }

    function hideStars() {
      starsEl.hidden = true;
      scoreBtnEl.classList.add('is-clickable');
    }

    function updateDisplay(average: number, votes: number) {
      scoreEl.textContent = average > 0 ? average.toFixed(1) : '—';
      votesEl.textContent = votes > 0
        ? `${votes.toLocaleString('id-ID')} votes`
        : '';
    }

    // Init state
    const saved = localStorage.getItem(STORAGE_KEY);
    if (saved) {
      const stars = Number(saved);
      if (stars >= 1 && stars <= 5) {
        hideStars();
        highlightStars(stars);
      } else {
        showStars();
      }
    } else {
      showStars();
    }

    // Fetch komunitas
    (async () => {
      try {
        const res = await fetch(`${API_BASE}/api/v1/ratings/${animeId}`);
        if (!res.ok) return;
        const json = await res.json();
        const { average, votes } = json.data;

        if (votes > 0) updateDisplay(average, votes);
      } catch {}
    })();

    // Klik angka → muncul bintang untuk edit
    scoreBtnEl.addEventListener('click', () => {
      if (starsEl.hidden) {
        const saved = Number(localStorage.getItem(STORAGE_KEY) ?? 0);
        showStars(saved);
      }
    });

    // Klik bintang → submit
    starsEl.addEventListener('click', async (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-score-value]');
      if (!btn) return;

      const stars = Number(btn.dataset.scoreValue);
      highlightStars(stars);

      try {
        const res = await fetch(`${API_BASE}/api/v1/ratings/${animeId}`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ score: stars }),
        });
        const json = await res.json();

        if (json.ok) {
          localStorage.setItem(STORAGE_KEY, String(stars));
          updateDisplay(json.data.average, json.data.votes);
          hideStars();
        }
      } catch {}
    });
  });
</script>

<style>
  .anime-rating {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--s-2);
    padding-top: var(--s-2);
  }

  .anime-rating__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    gap: var(--s-2);
  }

  .anime-rating__stars {
    display: flex;
    gap: 2px;
  }

  .anime-rating__stars[hidden] {
    display: none;
  }

  .anime-rating__stars button {
    padding: 0;
    font-size: 1.125rem;
    line-height: 1;
    color: var(--text-disabled);
    background: transparent;
    border: none;
    cursor: pointer;
    transition: color var(--t-fast), transform var(--t-fast);
  }

  .anime-rating__stars button:hover,
  .anime-rating__stars button.is-active {
    color: var(--gold);
  }

  .anime-rating__stars button:hover {
    transform: scale(1.15);
  }

  .anime-rating__score {
    display: inline-flex;
    align-items: baseline;
    gap: 2px;
    padding: 0;
    background: transparent;
    border: none;
    cursor: default;
    line-height: 1;
  }

  .anime-rating__score.is-clickable {
    cursor: pointer;
    transition: opacity var(--t-fast);
  }

  .anime-rating__score.is-clickable:hover {
    opacity: 0.75;
  }

  .anime-rating__score span {
    font-size: var(--fs-xl);
    font-weight: var(--fw-bold);
    color: var(--accent);
  }

  .anime-rating__score small {
    font-size: var(--fs-xs);
    color: var(--text-muted);
  }

  .anime-rating__votes {
    margin: 0;
    font-size: var(--fs-xs);
    color: var(--text-muted);
    text-align: center;
    line-height: 1.2;
  }
</style>