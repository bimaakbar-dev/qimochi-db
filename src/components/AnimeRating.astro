---
interface Props {
  malScore?: number;
  malVotes?: number;
}

const { malScore, malVotes } = Astro.props;

const hasScore = malScore != null && malScore > 0;
const fillPercent = hasScore ? (malScore / 10) * 100 : 0;
const displayScore = hasScore ? malScore.toFixed(1) : '—';
const votesLabel = (() => {
  if (!hasScore) return 'Belum ada rating';
  if (malVotes == null || malVotes === 0) return '';
  return `${malVotes.toLocaleString('id-ID')} votes`;
})();
---

<div class="anime-rating">
  <div class="anime-rating__stars">
    <div class="stars__layer stars__layer--bg" aria-hidden="true">
      <span>★</span><span>★</span><span>★</span><span>★</span><span>★</span>
    </div>
    <div
      class="stars__layer stars__layer--fill"
      style={`--fill: ${fillPercent}%`}
      aria-hidden="true"
    >
      <span>★</span><span>★</span><span>★</span><span>★</span><span>★</span>
    </div>
  </div>

  <div class="anime-rating__score">
    <span>{displayScore}</span>
    <small>/ 10</small>
  </div>

  <p class="anime-rating__votes" aria-live="polite">{votesLabel}</p>
</div>

<style>
  .anime-rating {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--s-2);
    padding-top: var(--s-2);
  }

  .anime-rating__stars {
    position: relative;
    display: inline-block;
    line-height: 1;
    --star-size: 1.125rem;
    --star-gap: 1px;
  }

  .stars__layer {
    display: flex;
    gap: var(--star-gap);
    font-size: var(--star-size);
  }

  .stars__layer span {
    flex: 0 0 var(--star-size);
    width: var(--star-size);
    height: var(--star-size);
    text-align: center;
    line-height: 1;
  }

  .stars__layer--bg {
    color: var(--text-disabled);
  }

  .stars__layer--fill {
    position: absolute;
    top: 0;
    left: 0;
    color: var(--gold);
    width: var(--fill, 0%);
    overflow: hidden;
    pointer-events: none;
  }

  .anime-rating__score {
    display: inline-flex;
    align-items: baseline;
    gap: 2px;
    line-height: 1;
  }

  .anime-rating__score span {
    font-size: var(--fs-xl);
    font-weight: var(--fw-bold);
    color: var(--accent);
  }

  .anime-rating__score small {
    font-size: var(--fs-xs);
    color: var(--text-muted);
  }

  .anime-rating__votes {
    margin: 0;
    font-size: var(--fs-xs);
    color: var(--text-muted);
    text-align: center;
    line-height: 1.2;
    min-height: 1em;
  }
</style>