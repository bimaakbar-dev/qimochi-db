---
interface Props {
  animeId: string;
  malScore?: number;
  malVotes?: number;
}

const { animeId, malScore, malVotes } = Astro.props;
const hasMal = malScore != null && malVotes != null;
---

<div class="anime-rating" data-anime-rating data-anime-id={animeId}>
  <div class="anime-rating__row">
    <div class="stars" data-stars>
      <div class="stars__layer stars__layer--bg" aria-hidden="true">
        <span>★</span><span>★</span><span>★</span><span>★</span><span>★</span>
      </div>
      <div class="stars__layer stars__layer--fill" data-fill aria-hidden="true">
        <span>★</span><span>★</span><span>★</span><span>★</span><span>★</span>
      </div>
      <div class="stars__buttons" role="group" aria-label="Rating 1-5 bintang">
        <button type="button" data-score-value="1" aria-label="1 bintang"></button>
        <button type="button" data-score-value="2" aria-label="2 bintang"></button>
        <button type="button" data-score-value="3" aria-label="3 bintang"></button>
        <button type="button" data-score-value="4" aria-label="4 bintang"></button>
        <button type="button" data-score-value="5" aria-label="5 bintang"></button>
      </div>
    </div>

    <div class="anime-rating__score">
      <span data-score>{hasMal ? malScore.toFixed(1) : '—'}</span>
      <small>/ 10</small>
    </div>
  </div>

  <p class="anime-rating__votes" data-votes>
    {hasMal ? `${malVotes.toLocaleString('id-ID')} votes` : ''}
  </p>
</div>

<script>
  const API_BASE = 'https://qimochi-api.bimaakbar.workers.dev';

  document.querySelectorAll<HTMLElement>('[data-anime-rating]').forEach((el) => {
    const animeId = el.dataset.animeId!;
    const starsEl = el.querySelector<HTMLElement>('[data-stars]')!;
    const fillEl = el.querySelector<HTMLElement>('[data-fill]')!;
    const scoreEl = el.querySelector<HTMLElement>('[data-score]')!;
    const votesEl = el.querySelector<HTMLElement>('[data-votes]')!;

    const STORAGE_KEY = `qimochi:rating:${animeId}`;

    const state = {
      average: 0,
      votes: 0,
      userStars: 0,
    };

    // Ambil dari fallback MAL (kalau ada)
    const initialScore = Number(scoreEl.textContent);
    if (!isNaN(initialScore) && initialScore > 0) {
      state.average = initialScore;
    }

    // Restore user vote dari localStorage
    const saved = localStorage.getItem(STORAGE_KEY);
    if (saved) {
      const stars = Number(saved);
      if (stars >= 1 && stars <= 5) state.userStars = stars;
    }

    function getFillPercent(): number {
      if (state.userStars > 0) return (state.userStars / 5) * 100;
      if (state.average > 0) return (state.average / 10) * 100;
      return 0;
    }

    function renderFill() {
      fillEl.style.setProperty('--fill', getFillPercent() + '%');
    }

    function renderScore() {
      scoreEl.textContent = state.average > 0 ? state.average.toFixed(1) : '—';
    }

    function renderVotes() {
      votesEl.textContent = state.votes > 0
        ? `${state.votes.toLocaleString('id-ID')} votes`
        : '';
    }

    // Initial render
    renderFill();

    // Fetch komunitas dari Worker
    (async () => {
      try {
        const res = await fetch(`${API_BASE}/api/v1/ratings/${animeId}`);
        if (!res.ok) return;
        const json = await res.json();
        const { average, votes } = json.data;

        if (votes > 0) {
          state.average = average;
          state.votes = votes;
          renderScore();
          renderVotes();
          renderFill();
        }
      } catch {}
    })();

    // Hover preview
    starsEl.querySelectorAll<HTMLButtonElement>('[data-score-value]').forEach((btn) => {
      btn.addEventListener('mouseenter', () => {
        const stars = Number(btn.dataset.scoreValue);
        fillEl.style.setProperty('--fill', (stars / 5) * 100 + '%');
      });
    });

    starsEl.addEventListener('mouseleave', () => {
      renderFill();
    });

    // Klik → submit vote
    starsEl.addEventListener('click', async (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-score-value]');
      if (!btn) return;

      const stars = Number(btn.dataset.scoreValue);

      try {
        const res = await fetch(`${API_BASE}/api/v1/ratings/${animeId}`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ score: stars }),
        });
        const json = await res.json();

        if (json.ok) {
          state.userStars = stars;
          state.average = json.data.average;
          state.votes = json.data.votes;

          localStorage.setItem(STORAGE_KEY, String(stars));

          renderFill();
          renderScore();
          renderVotes();
        }
      } catch {}
    });
  });
</script>

<style>
  .anime-rating {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--s-2);
    padding-top: var(--s-2);
  }

  .anime-rating__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    gap: var(--s-3);
  }

  /* ============================================================
     STARS — Progress Bar
     ============================================================ */
  .stars {
    --star-size: 1.125rem;
    --star-gap: 1px;

    position: relative;
    display: inline-block;
    line-height: 1;
  }

  .stars__layer {
    display: flex;
    gap: var(--star-gap);
    font-size: var(--star-size);
  }

  .stars__layer span {
    flex: 0 0 var(--star-size);
    width: var(--star-size);
    height: var(--star-size);
    text-align: center;
    line-height: 1;
  }

  .stars__layer--bg {
    color: var(--text-disabled);
  }

  .stars__layer--fill {
    position: absolute;
    top: 0;
    left: 0;
    color: var(--gold);
    width: var(--fill, 0%);
    overflow: hidden;
    pointer-events: none;
    transition: width var(--t-fast) ease;
  }

  .stars__buttons {
    position: absolute;
    top: 0;
    left: 0;
    display: flex;
    gap: var(--star-gap);
  }

  .stars__buttons button {
    flex: 0 0 var(--star-size);
    width: var(--star-size);
    height: var(--star-size);
    padding: 0;
    background: transparent;
    border: none;
    cursor: pointer;
  }

  /* ============================================================
     SCORE + VOTES
     ============================================================ */
  .anime-rating__score {
    display: inline-flex;
    align-items: baseline;
    gap: 2px;
    line-height: 1;
  }

  .anime-rating__score span {
    font-size: var(--fs-xl);
    font-weight: var(--fw-bold);
    color: var(--accent);
  }

  .anime-rating__score small {
    font-size: var(--fs-xs);
    color: var(--text-muted);
  }

  .anime-rating__votes {
    margin: 0;
    font-size: var(--fs-xs);
    color: var(--text-muted);
    text-align: center;
    line-height: 1.2;
  }
</style>