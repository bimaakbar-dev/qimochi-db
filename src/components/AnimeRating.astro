---
interface Props {
  animeId: string;
  malScore?: number;
  malVotes?: number;
}

const { animeId, malScore, malVotes } = Astro.props;

const hasMal = malScore != null && malVotes != null;

const formatVotes = (n: number) =>
  n >= 1000000
    ? `${(n / 1000000).toFixed(1)}M`
    : n >= 1000
      ? `${(n / 1000).toFixed(1)}K`
      : String(n);
---

<div class="anime-rating" data-anime-rating data-anime-id={animeId}>
  <div class="anime-rating__display">
    <div class="anime-rating__score-wrap">
      <span class="anime-rating__score" data-score>
        {hasMal ? malScore.toFixed(1) : '—'}
      </span>
      <span class="anime-rating__scale">/ 10</span>
    </div>
    <div class="anime-rating__meta">
      <span class="anime-rating__votes" data-votes>
        {hasMal ? `${formatVotes(malVotes)} votes` : 'Belum ada vote'}
      </span>
      <span class="anime-rating__source" data-source>
        {hasMal ? 'dari MAL' : ''}
      </span>
    </div>
  </div>

  <div class="anime-rating__input">
    <p class="anime-rating__label">Kasih rating kamu:</p>
    <div class="anime-rating__stars" data-stars role="group" aria-label="Rating 1-5 bintang">
      <button type="button" data-score-value="1" aria-label="1 bintang">★</button>
      <button type="button" data-score-value="2" aria-label="2 bintang">★</button>
      <button type="button" data-score-value="3" aria-label="3 bintang">★</button>
      <button type="button" data-score-value="4" aria-label="4 bintang">★</button>
      <button type="button" data-score-value="5" aria-label="5 bintang">★</button>
    </div>
    <p class="anime-rating__message" data-message></p>
  </div>
</div>

<script>
  const API_BASE = 'https://qimochi-api.bimaakbar.workers.dev';

  function formatVotes(n: number): string {
    if (n >= 1000000) return `${(n / 1000000).toFixed(1)}M`;
    if (n >= 1000) return `${(n / 1000).toFixed(1)}K`;
    return String(n);
  }

  function highlightStars(container: HTMLElement, count: number) {
    container.querySelectorAll<HTMLButtonElement>('[data-score-value]').forEach((btn) => {
      const value = Number(btn.dataset.scoreValue);
      btn.classList.toggle('is-active', value <= count);
    });
  }

  document.querySelectorAll<HTMLElement>('[data-anime-rating]').forEach((el) => {
    const animeId = el.dataset.animeId!;
    const scoreEl = el.querySelector<HTMLElement>('[data-score]')!;
    const votesEl = el.querySelector<HTMLElement>('[data-votes]')!;
    const sourceEl = el.querySelector<HTMLElement>('[data-source]')!;
    const starsEl = el.querySelector<HTMLElement>('[data-stars]')!;
    const messageEl = el.querySelector<HTMLElement>('[data-message]')!;

    // Fetch dari Worker — override fallback MAL kalau ada vote
    (async () => {
      try {
        const res = await fetch(`${API_BASE}/api/v1/ratings/${animeId}`);
        if (!res.ok) return;
        const json = await res.json();
        const { average, votes } = json.data;

        if (votes > 0) {
          scoreEl.textContent = average.toFixed(1);
          votesEl.textContent = `${formatVotes(votes)} votes`;
          sourceEl.textContent = 'dari komunitas';
        }
      } catch {
        // Silent fail — fallback MAL tetap tampil
      }
    })();

    // Handle klik bintang
    starsEl.addEventListener('click', async (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-score-value]');
      if (!btn) return;

      const score = Number(btn.dataset.scoreValue);
      messageEl.textContent = 'Menyimpan...';

      try {
        const res = await fetch(`${API_BASE}/api/v1/ratings/${animeId}`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ score }),
        });
        const json = await res.json();

        if (json.ok) {
          messageEl.textContent = `✅ Rating kamu: ${score} bintang`;
          scoreEl.textContent = json.data.average.toFixed(1);
          votesEl.textContent = `${formatVotes(json.data.votes)} votes`;
          sourceEl.textContent = 'dari komunitas';
          highlightStars(starsEl, score);
        } else {
          messageEl.textContent = `❌ ${json.error.message}`;
        }
      } catch {
        messageEl.textContent = '❌ Gagal menyimpan rating';
      }
    });
  });
</script>

<style>
  .anime-rating {
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
  }

  .anime-rating__display {
    display: flex;
    align-items: baseline;
    gap: var(--s-3);
  }

  .anime-rating__score-wrap {
    display: flex;
    align-items: baseline;
    gap: var(--s-1);
  }

  .anime-rating__score {
    font-size: var(--fs-3xl);
    font-weight: var(--fw-bold);
    color: var(--accent);
    line-height: 1;
  }

  .anime-rating__scale {
    font-size: var(--fs-base);
    color: var(--text-muted);
  }

  .anime-rating__meta {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .anime-rating__votes {
    font-size: var(--fs-xs);
    color: var(--text-secondary);
  }

  .anime-rating__source {
    font-size: var(--fs-xs);
    color: var(--text-muted);
  }

  .anime-rating__input {
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
  }

  .anime-rating__label {
    margin: 0;
    font-size: var(--fs-xs);
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .anime-rating__stars {
    display: flex;
    gap: var(--s-1);
  }

  .anime-rating__stars button {
    padding: 0;
    font-size: 1.75rem;
    line-height: 1;
    color: var(--text-disabled);
    background: transparent;
    border: none;
    cursor: pointer;
    transition: color var(--t-fast), transform var(--t-fast);
  }

  .anime-rating__stars button:hover,
  .anime-rating__stars button.is-active {
    color: var(--gold);
  }

  .anime-rating__stars button:hover {
    transform: scale(1.1);
  }

  .anime-rating__message {
    margin: 0;
    min-height: 1.2em;
    font-size: var(--fs-xs);
    color: var(--text-secondary);
  }
</style>