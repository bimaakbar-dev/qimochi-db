---
interface Props {
  animeId: string;
}

const { animeId } = Astro.props;
---

<div class="anime-rating" data-anime-rating data-anime-id={animeId}>
  <div class="anime-rating__row">
    <div class="stars" data-stars>
      <div class="stars__layer stars__layer--bg" aria-hidden="true">
        <span>★</span><span>★</span><span>★</span><span>★</span><span>★</span>
      </div>
      <div class="stars__layer stars__layer--fill" data-fill aria-hidden="true">
        <span>★</span><span>★</span><span>★</span><span>★</span><span>★</span>
      </div>
      <div
        class="stars__buttons"
        role="group"
        aria-label="Beri rating 1 sampai 5 bintang"
      >
        <button type="button" data-score-value="1" aria-label="Beri 1 bintang" title="1 bintang"></button>
        <button type="button" data-score-value="2" aria-label="Beri 2 bintang" title="2 bintang"></button>
        <button type="button" data-score-value="3" aria-label="Beri 3 bintang" title="3 bintang"></button>
        <button type="button" data-score-value="4" aria-label="Beri 4 bintang" title="4 bintang"></button>
        <button type="button" data-score-value="5" aria-label="Beri 5 bintang" title="5 bintang"></button>
      </div>
    </div>

    <div class="anime-rating__score">
      <span class="anime-rating__skeleton" data-skeleton aria-hidden="true"></span>
      <span data-score hidden>—</span>
      <small data-score-unit hidden>/ 10</small>
    </div>
  </div>

  <p class="anime-rating__votes" data-votes></p>
  <p class="anime-rating__user" data-user-score hidden></p>
</div>

<script>
  const API_BASE = import.meta.env.PUBLIC_API_URL ?? 'https://yukio-api.bimaakbar.workers.dev';
  const USER_ID_KEY = 'yukionime:user-id';
  const CACHE_TTL = 5 * 60 * 1000;
  const MIN_VOTES_TO_SHOW = 3;
  const UUID_RE = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;

  function getUserId(): string {
    let id = localStorage.getItem(USER_ID_KEY);
    if (!id || !UUID_RE.test(id)) {
      id = crypto.randomUUID();
      localStorage.setItem(USER_ID_KEY, id);
    }
    return id;
  }

  function readCache(animeId: string) {
    try {
      const raw = localStorage.getItem(`yukionime:rating-cache:${animeId}`);
      if (!raw) return null;
      const parsed = JSON.parse(raw);
      if (
        typeof parsed?.average !== 'number' ||
        typeof parsed?.votes !== 'number' ||
        typeof parsed?.provisional !== 'boolean' ||
        typeof parsed?.ts !== 'number'
      ) return null;
      return parsed as {
        average: number;
        rawAverage: number;
        votes: number;
        provisional: boolean;
        ts: number;
      };
    } catch {
      return null;
    }
  }

  function writeCache(
    animeId: string,
    data: { average: number; rawAverage: number; votes: number; provisional: boolean }
  ) {
    try {
      localStorage.setItem(
        `yukionime:rating-cache:${animeId}`,
        JSON.stringify({ ...data, ts: Date.now() })
      );
    } catch {}
  }

  function readUserScore(animeId: string): number {
    const raw = localStorage.getItem(`yukionime:rating-user:${animeId}`);
    const n = Number(raw);
    return Number.isInteger(n) && n >= 1 && n <= 5 ? n : 0;
  }

  function writeUserScore(animeId: string, score: number) {
    localStorage.setItem(`yukionime:rating-user:${animeId}`, String(score));
  }

  const userId = getUserId();

  document.querySelectorAll<HTMLElement>('[data-anime-rating]').forEach((el) => {
    const animeId = el.dataset.animeId!;
    const starsEl = el.querySelector<HTMLElement>('[data-stars]')!;
    const fillEl = el.querySelector<HTMLElement>('[data-fill]')!;
    const scoreEl = el.querySelector<HTMLElement>('[data-score]')!;
    const unitEl = el.querySelector<HTMLElement>('[data-score-unit]')!;
    const skeletonEl = el.querySelector<HTMLElement>('[data-skeleton]')!;
    const votesEl = el.querySelector<HTMLElement>('[data-votes]')!;
    const userEl = el.querySelector<HTMLElement>('[data-user-score]')!;

    const state = {
      average: 0,
      rawAverage: 0,
      votes: 0,
      provisional: false,
      userScore: readUserScore(animeId),
    };

    function renderFill() {
      const showStars = state.votes >= MIN_VOTES_TO_SHOW && state.average > 0;
      const pct = showStars ? (state.average / 10) * 100 : 0;
      fillEl.style.setProperty('--fill', pct + '%');
    }

    function renderScore() {
      if (state.votes < MIN_VOTES_TO_SHOW) {
        scoreEl.textContent = '—';
        unitEl.hidden = true;
        return;
      }
      scoreEl.textContent = state.average.toFixed(1);
      unitEl.hidden = false;
    }

    function renderVotes() {
      if (state.votes === 0) {
        votesEl.textContent = 'Belum ada rating';
        return;
      }

      if (state.votes < MIN_VOTES_TO_SHOW) {
        const s = state.votes === 1 ? 'vote' : 'votes';
        votesEl.textContent = `${state.votes} ${s} · belum cukup`;
        return;
      }

      const s = state.votes === 1 ? 'vote' : 'votes';
      const suffix = state.provisional ? ' · skor sementara' : '';
      votesEl.textContent = `${state.votes.toLocaleString('id-ID')} ${s}${suffix}`;
    }

    function renderUserScore() {
      if (state.userScore > 0) {
        userEl.textContent = `Kamu: ${state.userScore} bintang`;
        userEl.hidden = false;
      } else {
        userEl.textContent = '';
        userEl.hidden = true;
      }
    }

    function showSkeleton(show: boolean) {
      skeletonEl.hidden = !show;
      if (show) {
        scoreEl.hidden = true;
        unitEl.hidden = true;
      } else {
        scoreEl.hidden = false;
      }
    }

    function renderAll() {
      showSkeleton(false);
      renderFill();
      renderScore();
      renderVotes();
      renderUserScore();
    }

    renderUserScore();

    const cached = readCache(animeId);

    if (cached) {
      state.average = cached.average;
      state.rawAverage = cached.rawAverage ?? 0;
      state.votes = cached.votes;
      state.provisional = cached.provisional;
      renderAll();

      const age = Date.now() - cached.ts;
      if (age > CACHE_TTL) fetchAggregate();
    } else {
      showSkeleton(true);
      fetchAggregate();
    }

    async function fetchAggregate() {
      try {
        const res = await fetch(`${API_BASE}/api/v1/ratings/${animeId}`);
        if (!res.ok) throw new Error(`HTTP ${res.status}`);

        const json = await res.json();
        const d = json.data;

        if (typeof d.average === 'number') state.average = d.average;
        if (typeof d.rawAverage === 'number') state.rawAverage = d.rawAverage;
        if (typeof d.votes === 'number') state.votes = d.votes;
        if (typeof d.provisional === 'boolean') state.provisional = d.provisional;

        writeCache(animeId, {
          average: state.average,
          rawAverage: state.rawAverage,
          votes: state.votes,
          provisional: state.provisional,
        });

        renderAll();
      } catch (err) {
        if (!cached) renderAll();
        console.error('[rating] fetch gagal:', err);
      }
    }

    starsEl.querySelectorAll<HTMLButtonElement>('[data-score-value]').forEach((btn) => {
      btn.addEventListener('mouseenter', () => {
        const stars = Number(btn.dataset.scoreValue);
        fillEl.style.setProperty('--fill', (stars / 5) * 100 + '%');
      });

      btn.addEventListener('focus', () => {
        const stars = Number(btn.dataset.scoreValue);
        fillEl.style.setProperty('--fill', (stars / 5) * 100 + '%');
      });
    });

    starsEl.addEventListener('mouseleave', renderFill);

    starsEl.addEventListener('focusout', (e) => {
      const next = e.relatedTarget as Node | null;
      if (!next || !starsEl.contains(next)) renderFill();
    });

    starsEl.addEventListener('click', async (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-score-value]');
      if (!btn) return;

      const stars = Number(btn.dataset.scoreValue);

      try {
        const res = await fetch(`${API_BASE}/api/v1/ratings/${animeId}`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'X-User-Id': userId,
          },
          body: JSON.stringify({ score: stars }),
        });

        if (!res.ok) throw new Error(`HTTP ${res.status}`);

        const json = await res.json();
        const d = json.data;

        if (typeof d.average === 'number') state.average = d.average;
        if (typeof d.rawAverage === 'number') state.rawAverage = d.rawAverage;
        if (typeof d.votes === 'number') state.votes = d.votes;
        if (typeof d.provisional === 'boolean') state.provisional = d.provisional;
        state.userScore = stars;

        writeCache(animeId, {
          average: state.average,
          rawAverage: state.rawAverage,
          votes: state.votes,
          provisional: state.provisional,
        });
        writeUserScore(animeId, stars);

        renderAll();
      } catch (err) {
        console.error('[rating] submit gagal:', err);
      }
    });
  });
</script>

<style>
  .anime-rating {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--s-2);
    padding-top: var(--s-2);
  }

  .anime-rating__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    gap: var(--s-3);
  }

  .stars {
    --star-size: 1.125rem;
    --star-gap: 1px;

    position: relative;
    display: inline-block;
    line-height: 1;
  }

  .stars__layer {
    display: flex;
    gap: var(--star-gap);
    font-size: var(--star-size);
  }

  .stars__layer span {
    flex: 0 0 var(--star-size);
    width: var(--star-size);
    height: var(--star-size);
    text-align: center;
    line-height: 1;
  }

  .stars__layer--bg {
    color: var(--text-disabled);
  }

  .stars__layer--fill {
    position: absolute;
    top: 0;
    left: 0;
    color: var(--gold);
    width: var(--fill, 0%);
    overflow: hidden;
    pointer-events: none;
    transition: width var(--t-fast) ease;
  }

  .stars__buttons {
    position: absolute;
    top: 0;
    left: 0;
    display: flex;
    gap: var(--star-gap);
  }

  .stars__buttons button {
    flex: 0 0 var(--star-size);
    width: var(--star-size);
    height: var(--star-size);
    padding: 0;
    background: transparent;
    border: none;
    cursor: pointer;
    border-radius: var(--r-sm);
    transition: box-shadow var(--t-fast);
  }

  .stars__buttons button:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  .anime-rating__score {
    display: inline-flex;
    align-items: baseline;
    gap: 2px;
    line-height: 1;
    min-height: 1.5rem;
  }

  .anime-rating__score span[data-score] {
    font-size: var(--fs-xl);
    font-weight: var(--fw-bold);
    color: var(--accent);
  }

  .anime-rating__score span[data-score][hidden] {
    display: none;
  }

  .anime-rating__score small {
    font-size: var(--fs-xs);
    color: var(--text-muted);
  }

  .anime-rating__score small[hidden] {
    display: none;
  }

  .anime-rating__skeleton {
    display: inline-block;
    width: 3rem;
    height: 1.25rem;
    border-radius: var(--r-sm);
    background: linear-gradient(
      90deg,
      var(--bg-surface) 0%,
      var(--bg-hover) 50%,
      var(--bg-surface) 100%
    );
    background-size: 200% 100%;
    animation: rating-shimmer 1.2s ease-in-out infinite;
  }

  .anime-rating__skeleton[hidden] {
    display: none;
  }

  @keyframes rating-shimmer {
    0% { background-position: 200% 0; }
    100% { background-position: -200% 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .anime-rating__skeleton {
      animation: none;
      background: var(--bg-surface);
    }
  }

  .anime-rating__votes {
    margin: 0;
    font-size: var(--fs-xs);
    color: var(--text-muted);
    text-align: center;
    line-height: 1.2;
    min-height: 1em;
  }

  .anime-rating__user {
    margin: 0;
    font-size: var(--fs-xs);
    color: var(--accent);
    text-align: center;
    line-height: 1.2;
  }

  .anime-rating__user[hidden] {
    display: none;
  }
</style>