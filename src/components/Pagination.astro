---
import { iconSvg } from '~/lib/icons';
import { buildPages } from '~/lib/pagination';

interface Props {
  mode?: 'render' | 'template';
  current?: number;
  total?: number;
  buildUrl?: (page: number) => string;
}

const {
  mode = 'render',
  current = 1,
  total = 1,
  buildUrl,
} = Astro.props;

const isTemplate = mode === 'template';

function resolveUrl(page: number): string {
  if (buildUrl) return buildUrl(page);
  return page === 1 ? './' : `./${page}/`;
}

const ArrowLeft = iconSvg('arrow-left');
const ArrowRight = iconSvg('arrow-right');
---

{isTemplate ? (
  <>
    <template id="pg-prev">
      <a class="page-btn" aria-label="Halaman sebelumnya" set:html={ArrowLeft} />
    </template>
    <template id="pg-prev-disabled">
      <span class="page-btn disabled" aria-hidden="true" set:html={ArrowLeft} />
    </template>
    <template id="pg-next">
      <a class="page-btn" aria-label="Halaman berikutnya" set:html={ArrowRight} />
    </template>
    <template id="pg-next-disabled">
      <span class="page-btn disabled" aria-hidden="true" set:html={ArrowRight} />
    </template>
    <template id="pg-number">
      <a class="page-num"></a>
    </template>
    <template id="pg-number-active">
      <span class="page-num active" aria-current="page"></span>
    </template>
    <template id="pg-ellipsis">
      <span class="page-ellipsis">…</span>
    </template>
  </>
) : (
  total > 1 && (
    <nav class="search-pagination" aria-label="Navigasi halaman">
      {current > 1 ? (
        <a class="page-btn" href={resolveUrl(current - 1)} aria-label="Halaman sebelumnya" set:html={ArrowLeft} />
      ) : (
        <span class="page-btn disabled" aria-hidden="true" set:html={ArrowLeft} />
      )}

      {buildPages(current, total).map((pg) =>
        pg === '...' ? (
          <span class="page-ellipsis">…</span>
        ) : pg === current ? (
          <span class="page-num active" aria-current="page">{pg}</span>
        ) : (
          <a class="page-num" href={resolveUrl(pg)}>{pg}</a>
        )
      )}

      {current < total ? (
        <a class="page-btn" href={resolveUrl(current + 1)} aria-label="Halaman berikutnya" set:html={ArrowRight} />
      ) : (
        <span class="page-btn disabled" aria-hidden="true" set:html={ArrowRight} />
      )}
    </nav>
  )
)}

<style is:global>
  /* ============================================================
     PAGINATION
     ============================================================ */
  .search-pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--s-1);
    margin-top: var(--s-6);
  }

  .search-pagination .page-btn,
  .search-pagination .page-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.5rem;
    height: 2.5rem;
    padding-inline: var(--s-2);
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--r-sm);
    font-size: var(--fs-sm);
    font-weight: var(--fw-medium);
    color: var(--text-secondary);
    font-variant-numeric: tabular-nums;
    text-decoration: none;
    transition: all var(--t-fast);
    cursor: pointer;
  }

  .search-pagination .page-btn:hover,
  .search-pagination .page-num:hover {
    background: var(--bg-hover);
    border-color: var(--border-hover);
    color: var(--text-primary);
  }

  .search-pagination .page-num.active {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--accent-text);
    cursor: default;
  }

  .search-pagination .page-num.active:hover {
    background: var(--accent);
    border-color: var(--accent);
  }

  .search-pagination .page-btn.disabled {
    color: var(--text-disabled);
    background: transparent;
    border-color: var(--border);
    pointer-events: none;
    opacity: 0.5;
  }

  .search-pagination .page-ellipsis {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.5rem;
    height: 2.5rem;
    color: var(--text-muted);
  }
</style>