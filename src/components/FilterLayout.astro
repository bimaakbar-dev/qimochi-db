---
import Icon from '~/user-components/Icons.astro';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={['filter-layout', className]}>
  <div class="filter-layout__main">
    <slot />
  </div>
  <button
    type="button"
    class="filter-layout__fab"
    data-filter-fab
    aria-label="Buka filter"
  >
    <Icon name="filter" size={20} />
    <span class="filter-layout__fab-badge" data-filter-count-badge hidden></span>
  </button>
  <dialog class="filter-layout__aside" data-filter-dialog>
    <div class="filter-layout__dialog-header">
      <span class="filter-layout__dialog-title">
        Filter
        <span class="filter-layout__dialog-count" data-filter-count-label hidden></span>
      </span>
      <button
        type="button"
        class="filter-layout__dialog-close"
        data-filter-close
        aria-label="Tutup filter"
      >
        <Icon name="close" size={16} />
      </button>
    </div>

    <div class="filter-layout__dialog-body">
      <slot name="sidebar" />
    </div>

    <div class="filter-layout__dialog-footer">
      <button
        type="button"
        class="filter-layout__dialog-btn filter-layout__dialog-btn--reset"
        data-filter-reset
      >
        Reset
      </button>
      <button
        type="button"
        class="filter-layout__dialog-btn filter-layout__dialog-btn--apply"
        data-filter-apply
      >
        Terapkan
      </button>
    </div>
  </dialog>
</div>

<script>
  // @ts-nocheck
  const fab = document.querySelector('[data-filter-fab]');
  const dialog = document.querySelector('[data-filter-dialog]');
  const closeBtn = document.querySelector('[data-filter-close]');
  const applyBtn = document.querySelector('[data-filter-apply]');
  const resetBtn = document.querySelector('[data-filter-reset]');
  const countBadge = document.querySelector('[data-filter-count-badge]');
  const countLabel = document.querySelector('[data-filter-count-label]');

  const FILTER_KEYS = ['status', 'type', 'genre', 'studio', 'season', 'year'];

  function countActiveFilters() {
    const sp = new URLSearchParams(location.search);
    let count = 0;
    for (const key of FILTER_KEYS) {
      if (sp.get(key)) count++;
    }
    return count;
  }

  function updateFilterCount() {
    const n = countActiveFilters();

    if (countBadge) {
      countBadge.textContent = String(n);
      countBadge.hidden = n === 0;
    }

    if (countLabel) {
      countLabel.textContent = n > 0 ? `· ${n} aktif` : '';
      countLabel.hidden = n === 0;
    }
  }

  updateFilterCount();

  fab?.addEventListener('click', () => {
    if (dialog && !dialog.open) dialog.showModal();
  });

  closeBtn?.addEventListener('click', () => dialog?.close());

  applyBtn?.addEventListener('click', () => dialog?.close());

  resetBtn?.addEventListener('click', () => {
    // Trigger klik di elemen reset yang ada di search page
    const searchReset = document.querySelector('[data-reset]');
    if (searchReset) {
      searchReset.click();
    } else {
      // Fallback: clear URL params filter
      const url = new URL(location.href);
      for (const key of FILTER_KEYS) url.searchParams.delete(key);
      url.searchParams.delete('page');
      location.href = url.toString();
    }
  });

  dialog?.addEventListener('click', (e) => {
    if (e.target === dialog) dialog.close();
  });

  window.addEventListener('resize', () => {
    if (!dialog?.open) return;
    if (window.matchMedia('(min-width: 50rem)').matches) {
      dialog.close();
    }
  });

  window.addEventListener('popstate', updateFilterCount);
  window.addEventListener('filter-updated', updateFilterCount);
</script>

<style>
  .filter-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s-6);
  }

  .filter-layout__main {
    display: flex;
    flex-direction: column;
    gap: var(--s-10);
    min-width: 0;
  }

  .filter-layout__fab {
    position: fixed;
    bottom: calc(var(--s-4) + env(safe-area-inset-bottom, 0));
    right: calc(var(--s-4) + env(safe-area-inset-right, 0));
    z-index: calc(var(--z-header) - 1);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3.25rem;
    height: 3.25rem;
    padding: 0;
    color: var(--accent-text);
    background: var(--accent);
    border: none;
    border-radius: var(--r-full);
    cursor: pointer;
    box-shadow: var(--shadow-lg);
    transition: transform var(--t-fast), background-color var(--t-fast);
  }

  .filter-layout__fab:hover {
    background: var(--accent-hover);
    transform: translateY(-2px);
  }

  .filter-layout__fab:active {
    transform: translateY(0) scale(0.95);
  }

  .filter-layout__fab-badge {
    position: absolute;
    top: -2px;
    right: -2px;
    min-width: 1.25rem;
    height: 1.25rem;
    padding-inline: 4px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 0.6875rem;
    font-weight: var(--fw-bold);
    line-height: 1;
    color: var(--accent);
    background: var(--text-inverted);
    border: 2px solid var(--accent);
    border-radius: var(--r-full);
  }

  .filter-layout__fab-badge[hidden] {
    display: none;
  }

  .filter-layout__aside {
    position: fixed;
    inset: auto 0 0 0;
    width: 100%;
    max-width: none;
    max-height: 85vh;
    margin: 0;
    padding: 0;
    padding-left: env(safe-area-inset-left, 0);
    padding-right: env(safe-area-inset-right, 0);
    border: none;
    border-radius: var(--r-lg) var(--r-lg) 0 0;
    background: var(--bg-elevated);
    color: var(--text-primary);
  }

  .filter-layout__aside[open] {
    display: flex;
    flex-direction: column;
  }

  .filter-layout__aside::backdrop {
    background: hsla(30, 3%, 5%, 0.55);
  }

  /* Header */
  .filter-layout__dialog-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-shrink: 0;
    padding: var(--s-3) var(--s-4);
    border-bottom: 1px solid var(--border);
    font-size: var(--fs-base);
    font-weight: var(--fw-semibold);
    color: var(--text-primary);
  }

  .filter-layout__dialog-title {
    display: inline-flex;
    align-items: baseline;
    gap: var(--s-1);
  }

  .filter-layout__dialog-count {
    font-size: var(--fs-xs);
    font-weight: var(--fw-normal);
    color: var(--accent);
  }

  .filter-layout__dialog-close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    padding: 0;
    background: transparent;
    border: none;
    border-radius: var(--r-full);
    color: var(--text-muted);
    cursor: pointer;
    transition: color var(--t-fast), background-color var(--t-fast);
  }

  .filter-layout__dialog-close:hover {
    color: var(--text-primary);
    background: var(--bg-hover);
  }

  /* Body */
  .filter-layout__dialog-body {
    flex: 1;
    overflow-y: auto;
    padding: var(--s-4);
    overscroll-behavior: contain;
  }

  /* Footer */
  .filter-layout__dialog-footer {
    display: flex;
    gap: var(--s-2);
    flex-shrink: 0;
    padding: var(--s-3) var(--s-4);
    border-top: 1px solid var(--border);
    background: var(--bg-elevated);
    padding-bottom: calc(var(--s-3) + env(safe-area-inset-bottom, 0));
  }

  .filter-layout__dialog-btn {
    flex: 1;
    padding: var(--s-2) var(--s-4);
    font: inherit;
    font-size: var(--fs-sm);
    font-weight: var(--fw-semibold);
    border-radius: var(--r-md);
    cursor: pointer;
    transition: background-color var(--t-fast), color var(--t-fast), border-color var(--t-fast);
  }

  .filter-layout__dialog-btn--reset {
    color: var(--text-primary);
    background: transparent;
    border: 1px solid var(--border);
  }

  .filter-layout__dialog-btn--reset:hover {
    border-color: var(--border-hover);
    background: var(--bg-hover);
  }

  .filter-layout__dialog-btn--apply {
    color: var(--accent-text);
    background: var(--accent);
    border: 1px solid var(--accent);
  }

  .filter-layout__dialog-btn--apply:hover {
    background: var(--accent-hover);
    border-color: var(--accent-hover);
  }

  @media (min-width: 50rem) {
    .filter-layout {
      grid-template-columns: minmax(0, 1fr) var(--aside-width);
      gap: var(--s-10);
    }

    .filter-layout__fab {
      display: none;
    }

    .filter-layout__aside {
      display: block !important;
      position: sticky;
      inset: auto;
      top: var(--sticky-top);
      align-self: start;
      width: auto;
      max-height: none;
      border-radius: 0;
      background: transparent;
    }

    .filter-layout__dialog-header,
    .filter-layout__dialog-footer {
      display: none;
    }

    .filter-layout__dialog-body {
      padding: 0;
      overflow: visible;
    }
  }
</style>