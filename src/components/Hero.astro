---
interface Props {
  title: string;
  description?: string;
  size?: 'md' | 'lg';
}

const {
  title,
  description,
  size = 'md',
} = Astro.props;
---

<header class:list={['hero', `hero-${size}`]}>
  <div class="hero-inner">
    <h1 class="hero-title">{title}</h1>
    {description && <p class="hero-desc">{description}</p>}
    <slot />
  </div>
</header>

<style>
  .hero {
    background: var(--bg-footer);
    margin-inline: calc(50% - 50vw);
    margin-block-start: calc(var(--s-6) * -1);
    margin-block-end: var(--s-6);
  }

  .hero-inner {
    max-width: var(--content-max-mobile);
    margin-inline: auto;
    padding: var(--s-6) var(--pad-x);

    display: flex;
    flex-direction: column;
    gap: var(--s-3);
  }

  .hero-title {
    margin: 0;
    font-weight: var(--fw-semibold);
    line-height: var(--lh-tight);
    color: var(--text-inverted);
  }

  .hero-md .hero-title {
    font-size: var(--fs-3xl);
  }

  .hero-lg .hero-title {
    font-size: var(--fs-4xl);
  }

  .hero-desc {
    margin: 0;
    font-size: var(--fs-sm);
    line-height: var(--lh-relaxed);
    color: var(--text-inverted);
    opacity: 0.75;
    max-width: 60ch;
  }
  
  @media (min-width: 50rem) {
    .hero-inner {
      max-width: var(--content-max-desktop);
    }
  }
</style>