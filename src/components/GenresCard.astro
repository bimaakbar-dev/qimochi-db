---
import { getCollection } from 'astro:content';
import SectionCard from '~/components/SectionCard.astro';
import { countByArrayField } from '~/lib/data';

const genres = await getCollection('genres');
const allAnime = await getCollection('anime', ({ data }) => !data.draft);

const countMap = countByArrayField(allAnime, 'genres');

const categoryOrder = { genre: 0, theme: 1, demographic: 2 } as const;
const sorted = [...genres].sort((a, b) => {
  const catDiff =
    categoryOrder[a.data.category] - categoryOrder[b.data.category];
  if (catDiff !== 0) return catDiff;
  return a.data.name.localeCompare(b.data.name);
});

const items = sorted
  .map((g) => ({
    id: g.data.id,
    name: g.data.name,
    count: countMap.get(g.data.id) ?? 0,
  }))
  .filter((g) => g.count > 0);
---

<SectionCard
  title="Genre"
  filterKey="genre"
  urlPrefix="/search/anime/?genre="
  items={items}
/>