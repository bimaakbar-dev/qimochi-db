---
import {
  STATUS_LABEL,
  SOURCE_LABEL,
  AGE_RATING_LABEL,
  SEASON_LABEL,
  type Status,
  type Source,
  type AgeRating,
  type Season,
} from '~/constants';

import { formatDateRange, formatDuration } from '~/lib/format';
import SectionLabel from '~/components/SectionLabel.astro';

interface StudioItem {
  slug: string;
  name: string;
}

interface Props {
  title: string;
  titleEnglish?: string;
  titleNative?: string;
  type: string;
  status: string;
  source?: string;
  season?: string;
  year?: number;
  episodes?: number | null;
  duration?: number;
  rating?: string;
  aired?: { from: string; to?: string | null };
  studios?: StudioItem[];
  malId?: number;
  anilistId?: number;
  kitsuId?: string;
}

const {
  title,
  titleEnglish,
  titleNative,
  type,
  status,
  source,
  season,
  year,
  episodes,
  duration,
  rating,
  aired,
  studios = [],
  malId,
  anilistId,
  kitsuId,
} = Astro.props;

const seasonLabel = season
  ? SEASON_LABEL[season as Season] ?? season
  : null;

const airedLabel = aired?.from
  ? formatDateRange(aired.from, aired.to)
  : null;

const totalMinutes =
  episodes != null && duration != null ? episodes * duration : null;
const lengthLabel = totalMinutes
  ? `${formatDuration(totalMinutes)} total (${duration} menit/episode)`
  : null;

const ratingLabel = rating
  ? AGE_RATING_LABEL[rating as AgeRating] ?? rating
  : null;

const statusLabel = STATUS_LABEL[status as Status] ?? status;
const sourceLabel = source
  ? SOURCE_LABEL[source as Source] ?? source
  : null;

const hasExternal =
  malId != null || anilistId != null || kitsuId != null;
---

<div class="anime-meta-wrap">
  <SectionLabel as="h3" size="sm">Detail</SectionLabel>

  <dl class="anime-meta">
    {titleEnglish && titleEnglish !== title && (
      <div class="anime-meta__row">
        <dt>Inggris</dt>
        <dd>{titleEnglish}</dd>
      </div>
    )}

    {titleNative && (
      <div class="anime-meta__row">
        <dt>Jepang</dt>
        <dd>{titleNative}</dd>
      </div>
    )}

    <div class="anime-meta__row">
      <dt>Romaji</dt>
      <dd>{title}</dd>
    </div>

    <div class="anime-meta__row">
      <dt>Tipe</dt>
      <dd>{type}</dd>
    </div>

    <div class="anime-meta__row">
      <dt>Episode</dt>
      <dd>{episodes != null ? episodes : '?'}</dd>
    </div>

    <div class="anime-meta__row">
      <dt>Status</dt>
      <dd>{statusLabel}</dd>
    </div>

    {airedLabel && (
      <div class="anime-meta__row">
        <dt>Aired</dt>
        <dd>{airedLabel}</dd>
      </div>
    )}

    {(seasonLabel || year) && (
      <div class="anime-meta__row">
        <dt>Musim</dt>
        <dd>{[seasonLabel, year].filter(Boolean).join(' ')}</dd>
      </div>
    )}

    {ratingLabel && (
      <div class="anime-meta__row">
        <dt>Rating</dt>
        <dd>{ratingLabel}</dd>
      </div>
    )}

    {lengthLabel && (
      <div class="anime-meta__row">
        <dt>Length</dt>
        <dd>{lengthLabel}</dd>
      </div>
    )}

    {sourceLabel && (
      <div class="anime-meta__row">
        <dt>Sumber</dt>
        <dd>{sourceLabel}</dd>
      </div>
    )}

    {studios.length > 0 && (
      <div class="anime-meta__row">
        <dt>Studio</dt>
        <dd>
          {studios.map((s, i) => (
            <>
              {i > 0 && ', '}
              <a
                href={`/search/anime/?studio=${s.slug}`}
                class="anime-meta__link"
              >
                {s.name}
              </a>
            </>
          ))}
        </dd>
      </div>
    )}
  </dl>

  {hasExternal && (
    <div class="anime-meta__external">
      <p class="anime-meta__external-title">Sumber Eksternal</p>
      <ul class="anime-meta__external-list">
        {malId && (
          <li>
            <a href={`https://myanimelist.net/anime/${malId}`} target="_blank" rel="noopener noreferrer">
              MyAnimeList
            </a>
          </li>
        )}
        {anilistId && (
          <li>
            <a href={`https://anilist.co/anime/${anilistId}`} target="_blank" rel="noopener noreferrer">
              AniList
            </a>
          </li>
        )}
        {kitsuId && (
          <li>
            <a href={`https://kitsu.app/anime/${kitsuId}`} target="_blank" rel="noopener noreferrer">
              Kitsu
            </a>
          </li>
        )}
      </ul>
    </div>
  )}
</div>

<style>
  .anime-meta-wrap {
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
  }

  .anime-meta {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    margin: 0;
  }

  .anime-meta__row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2px;
  }

  .anime-meta__link {
    color: var(--accent);
    text-decoration: none;
    transition: color var(--t-fast);
  }

  .anime-meta__link:hover {
    color: var(--accent-hover);
  }

  @media (min-width: 50rem) {
    .anime-meta__row {
      grid-template-columns: 6rem minmax(0, 1fr);
      column-gap: var(--s-3);
      align-items: baseline;
    }
  }

  .anime-meta__row dt {
    font-size: var(--fs-xs);
    font-weight: var(--fw-medium);
    color: var(--text-primary);
    letter-spacing: 0.05em;
  }

  .anime-meta__row dd {
    margin: 0;
    font-size: var(--fs-sm);
    color: var(--text-primary);
    line-height: 1.4;
  }

  .anime-meta__external {
    margin-top: var(--s-2);
    padding-top: var(--s-4);
    border-top: 1px solid var(--border);
  }

  .anime-meta__external-title {
    margin: 0 0 var(--s-2);
    font-size: var(--fs-xs);
    font-weight: var(--fw-medium);
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .anime-meta__external-list {
    display: flex;
    flex-direction: column;
    gap: var(--s-1);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .anime-meta__external-list a {
    font-size: var(--fs-sm);
    color: var(--accent);
    text-decoration: none;
    transition: color var(--t-fast);
  }

  .anime-meta__external-list a:hover {
    color: var(--accent-hover);
  }
</style>