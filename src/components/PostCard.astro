---
import Badge from '~/user-components/Badge.astro';
import { postUrl, formatDateShort } from '~/lib/blog';

interface Props {
  post: {
    id: string;
    data: {
      title: string;
      description: string;
      cover?: string;
      date: Date;
      category: string;
      tags: string[];
    };
  };
  featured?: boolean;
}

const { post, featured = false } = Astro.props;
const { id, data } = post;

const dateText = formatDateShort(data.date);
const url = postUrl(id);
---

<a
  href={url}
  class:list={['post-card', { 'post-card-featured': featured }]}
>
  <div class="cover">
    {data.cover ? (
      <img
        src={data.cover}
        alt=""
        width="800"
        height="450"
        loading="lazy"
        decoding="async"
      />
    ) : (
      <div class="cover-fallback" aria-hidden="true">{data.category}</div>
    )}
  </div>
  <div class="body">
    <time class="date" datetime={data.date.toISOString()}>
      {dateText}
    </time>

    <div class="content">
      <Badge variant="accent" size="sm">{data.category}</Badge>

      <h3 class="title">
        <span class="title-text">{data.title}</span>
      </h3>

      <p class="description">{data.description}</p>
    </div>
  </div>
</a>

<style>
  .post-card {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    min-width: 0;
    text-decoration: none;
    color: inherit;
    padding-inline: var(--s-4);
  }

  .cover {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--bg-surface);
  }

  .post-card-featured .cover {
    aspect-ratio: 3 / 2;
  }

  .cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform var(--t-base);
  }

  .post-card:hover .cover img {
    transform: scale(1.03);
  }

  .cover-fallback {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-muted);
    font-size: var(--fs-sm);
    font-weight: var(--fw-semibold);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .body {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--s-4);
    align-items: start;
    min-width: 0;
  }

  .date {
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    font-size: var(--fs-xs);
    font-weight: var(--fw-medium);
    color: var(--text-muted);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .content {
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
    min-width: 0;
    align-items: flex-start;
    & span {
      text-transform: uppercase;
    }
  }

  .title {
    font-size: var(--fs-2xl);
    font-weight: var(--fw-bold);
    line-height: var(--lh-tight);
    margin: 0;
    min-width: 0;
  }

  .post-card-featured .title {
    font-size: var(--fs-xl);
  }

  .title-text {
    position: relative;
    display: inline;
    color: var(--text-primary);
    transition: color var(--t-fast);
  }
  .title-text::after {
    content: '';
    position: absolute;
    left: -3%;
    right: -3%;
    bottom: -0.1em;
    height: 0.45em;
    background-color: var(--text-primary);
    -webkit-mask-image: var(--underline);
    mask-image: var(--underline);
    -webkit-mask-size: 100% 100%;
    mask-size: 100% 100%;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    pointer-events: none;
    opacity: 0;
    transition: opacity var(--t-fast);
  }
  .post-card:hover .title-text::after {
    opacity: 1;
  }

  .description {
    display: none;
    font-size: var(--fs-sm);
    color: var(--text-secondary);
    line-height: var(--lh-relaxed);
    margin: 0;
    min-width: 0;
  }

  @media (min-width: 50rem) {
    .post-card {
      padding-inline: 0;
    }
    .description {
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    .post-card-featured .description {
      -webkit-line-clamp: 3;
    }
  }
</style>