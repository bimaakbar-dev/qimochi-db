---
import Icon from './Icons.astro';

type IconName = Parameters<typeof Icon>[0]['name'];

interface Props {
  href: string;
  variant?: 'accent' | 'outline' | 'ghost' | 'gold';
  size?: 'sm' | 'md' | 'lg';
  icon?: IconName;
  iconPos?: 'prefix' | 'suffix';
  external?: boolean;
  block?: boolean;
  ariaLabel?: string;
  class?: string;
}

const {
  href,
  variant = 'accent',
  size = 'md',
  icon,
  iconPos = 'prefix',
  external = false,
  block = false,
  ariaLabel,
} = Astro.props;
---

<a
  href={href}
  class:list={[
    'link-btn',
    `btn-${variant}`,
    `btn-${size}`,
    { 'btn-block': block },
  ]}
  aria-label={ariaLabel}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
>
  {icon && iconPos === 'prefix' && <Icon name={icon} />}
  <span class="btn-label"><slot /></span>
  {icon && iconPos === 'suffix' && <Icon name={icon} />}
</a>

<style>
  .link-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--s-2);
    border-radius: var(--r-full);
    font-weight: var(--fw-medium);
    letter-spacing: 0.05em;
    text-decoration: none;
    white-space: nowrap;
    border: 1px solid transparent;
    transition: all var(--t-fast);
    cursor: pointer;
    user-select: none;
  }

  .btn-sm { padding: var(--s-1) var(--s-3); font-size: 0.6875rem; min-height: 1.875rem; }
  .btn-md { padding: var(--s-2) var(--s-4); font-size: var(--fs-xs); min-height: 2.25rem; }
  .btn-lg { padding: var(--s-3) var(--s-5); font-size: var(--fs-sm); min-height: 2.75rem; }

  .btn-label {
    display: inline-flex;
    align-items: center;
  }

  .link-btn :global(svg) {
    width: 1em;
    height: 1em;
    flex-shrink: 0;
  }

  .btn-accent {
    background: var(--accent);
    color: var(--accent-text);
    border-color: var(--accent);
  }
  .btn-accent:hover {
    background: var(--accent-hover);
    border-color: var(--accent-hover);
    color: var(--accent-text);
  }

  .btn-gold {
    background: var(--gold);
    color: #1a1a1a;
    border-color: var(--gold);
  }
  .btn-gold:hover {
    background: var(--gold-hover);
    border-color: var(--gold-hover);
    color: #1a1a1a;
  }
  .btn-outline {
    background: transparent;
    color: var(--accent);
    border-color: var(--accent);
  }
  .btn-outline:hover {
    opacity: 0.75;
  }

  .btn-ghost {
    background: transparent;
    color: var(--text-secondary);
    border-color: transparent;
  }
  .btn-ghost:hover {
    background: var(--bg-hover);
    color: var(--text-primary);
  }

  .btn-block { display: flex; width: 100%; }
</style>