---
import { ICON_PATHS, type IconName } from '~/lib/icons';

interface Props {
  name: IconName;
  size?: number;
}

const { name, size = 16 } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 16 16"
  fill="none"
  stroke="currentColor"
  stroke-width="1.75"
  stroke-linecap="square"
  stroke-linejoin="miter"
  aria-hidden="true"
  set:html={ICON_PATHS[name]}
/>