---
import Icon from '~/user-components/Icons.astro';

interface Props {
  slug: string;
  episodes: number[];
  currentEpisode?: number | null;
}

const { slug, episodes, currentEpisode = null } = Astro.props;
---

<details class="episode-list" open>
  <summary>
    <span class="label">Episode</span>
    <span class="count">({episodes.length})</span>
    <span class="chevron" aria-hidden="true">
      <Icon name="chevron-down" size={14} />
    </span>
  </summary>

  <ol class="episode-items">
    {episodes.map(num => {
      const isActive = num === currentEpisode;
      return (
        <li>
          <a
            href={`/watch/${slug}/${num}/`}
            class:list={['episode-item', { active: isActive }]}
            aria-current={isActive ? 'page' : undefined}
          >
            <span class="num">{String(num).padStart(2, '0')}</span>
          </a>
        </li>
      );
    })}
  </ol>
</details>

<style>
  .episode-list {
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    padding: var(--s-4);
  }

  .episode-list summary {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    cursor: pointer;
    font-weight: var(--fw-medium);
    font-size: var(--fs-sm);
    list-style: none;
  }

  .episode-list summary::-webkit-details-marker { display: none; }

  .episode-list summary .count {
    color: var(--text-muted);
    font-weight: var(--fw-normal);
  }

  .episode-list summary .chevron {
    display: inline-flex;
    align-items: center;
    margin-left: auto;
    color: var(--text-muted);
    transition: transform var(--t-base);
  }

  .episode-list[open] summary .chevron {
    transform: rotate(180deg);
  }

  /* Default: NO display set — biarkan browser hide saat closed */
  .episode-items {
    padding: 0;
    margin: var(--s-3) 0 0;
    list-style: none;
  }

  /* Hanya apply grid saat open */
  .episode-list[open] .episode-items {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(2.75rem, 1fr));
    gap: var(--s-2);
  }

  .episode-item {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 2.5rem;
    background: var(--bg-surface);
    border: 1px solid var(--border);
    color: var(--text-secondary);
    font-size: var(--fs-sm);
    font-weight: var(--fw-medium);
    font-variant-numeric: tabular-nums;
    transition: all var(--t-fast);
  }

  .episode-item:hover {
    border-color: var(--border-hover);
    color: var(--text-primary);
  }

  .episode-item.active {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--accent-text);
    pointer-events: none;
  }
</style>