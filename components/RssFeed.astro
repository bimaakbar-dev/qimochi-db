---
import LinkButton from '~/user-components/LinkButton.astro';
import SectionLabel from '~/components/SectionLabel.astro';

interface Props {
  label?: string;
  title?: string;
  description?: string;
  href?: string;
}

const {
  label = 'Subscribe',
  title = 'RSS Feed',
  description = 'Dapatkan notifikasi saat ada artikel baru tanpa harus buka situs.',
  href = '/rss.xml',
} = Astro.props;
---

<section class="aside-block">
  <SectionLabel as="h2">{label}</SectionLabel>

  <div class="aside-card">
    <SectionLabel as="h3" underlined={false}>{title}</SectionLabel>
    <p class="aside-card-desc">{description}</p>

    <LinkButton href={href} variant="accent" size="sm" icon="rss">
      Subscribe
    </LinkButton>
  </div>
</section>

<style>
  .aside-block {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    align-items: center;
  }

  .aside-card {
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    padding: var(--s-4);
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    align-items: flex-start;
    & h3  {
        font-size: var(--fs-base);
    }
  }

  .aside-card-desc {
    font-size: var(--fs-sm);
    color: var(--text-secondary);
    line-height: var(--lh-relaxed);
    margin: 0;
  }
</style>