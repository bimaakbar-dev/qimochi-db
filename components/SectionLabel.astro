---
interface Props {
  as?: 'h1' | 'h2' | 'h3' | 'h4';
  size?: 'sm' | 'md' | 'lg';
  underlined?: boolean;
}

const {
  as: Tag = 'h2',
  size = 'lg',
  underlined = true,
} = Astro.props;
---

<Tag
  class:list={[
    'section-label',
    `section-label-${size}`,
    { 'section-label-underlined': underlined },
  ]}
>
  <slot />
</Tag>

<style>
  .section-label {
    position: relative;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: var(--fw-semibold);
    margin: 0;
  }

  .section-label-sm {
    font-size: var(--fs-xs);
    color: var(--text-muted);
  }

  .section-label-md {
    font-size: var(--fs-lg);
    color: var(--text-primary);
  }

  .section-label-lg {
    font-size: var(--fs-xl);
    color: var(--text-primary);
  }

  .section-label-underlined::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.2em;
    height: 0.45em;
    background-color: var(--accent);

    -webkit-mask-image: var(--underline);
    mask-image: var(--underline);
    -webkit-mask-size: 100% 100%;
    mask-size: 100% 100%;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;

    pointer-events: none;
  }
</style>