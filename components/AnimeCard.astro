---
import Badge from '../user-components/Badge.astro';
import { URLS, STATUS_VARIANT, type Status } from '../constants';

interface Props {
  anime: {
    id: string;
    data: {
      title: string;
      cover: string;
      status: string;
      type: string;
      releaseDate: Date;
      episodes?: { number: number }[];
    };
  };
  featured?: boolean;
}

const { anime, featured = false } = Astro.props;
const { id, data } = anime;

const variant = STATUS_VARIANT[data.status as Status] ?? 'default';

const lastEpisode = data.episodes?.length
  ? Math.max(...data.episodes.map(e => e.number))
  : 0;
---

<a
  data-anime-title={data.title}
  href={URLS.anime(id)}
  class:list={['anime-card', { 'anime-card-featured': featured }]}
>
  <div class="cover">
    <img
      src={data.cover}
      alt={`Cover ${data.title}`}
      width="300"
      height="450"
      loading="lazy"
      decoding="async"
    />

    <span class="type-badge">{data.type}</span>

    <div class="status-overlay">
      <Badge variant={variant} size="sm">{data.status}</Badge>
    </div>
  </div>

  <div class="info">
    <h3 set:html={data.title} />
    {lastEpisode > 0 && (
      <span class="episodes">Ep {lastEpisode}</span>
    )}
  </div>
</a>

<style>
  .anime-card {
    display: block;
    min-width: 0;
    background: var(--bg-elevated);
    border: 1px solid transparent;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: transform var(--t-fast);
  }

  .cover {
    position: relative;
    aspect-ratio: 2 / 3;
    overflow: hidden;
    background: var(--bg-surface);
  }

  .cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform var(--t-base);
  }

  .anime-card:hover .cover img {
    transform: scale(1.03);
  }
  .anime-card:hover h3::after {
    opacity: 1;
  }

  .cover::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      transparent 50%,
      rgba(0, 0, 0, 0.6) 100%
    );
    pointer-events: none;
  }

  .type-badge {
    position: absolute;
    top: var(--s-2);
    right: var(--s-2);
    z-index: 2;

    display: inline-flex;
    align-items: center;
    padding: 2px 6px;

    background: rgba(0, 0, 0, 0.7);
    color: var(--text-inverted);
    font-size: 0.625rem;
    font-weight: var(--fw-semibold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    backdrop-filter: blur(8px);
  }

  .status-overlay {
    position: absolute;
    bottom: var(--s-2);
    left: var(--s-2);
    z-index: 2;
    & span {
      text-transform: uppercase;
    }
  }

  .info {
    padding: var(--s-3);
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
    min-width: 0;
  }

  .info h3 {
    position: relative;
    font-size: var(--fs-sm);
    font-weight: var(--fw-semibold);
    color: var(--text-primary);
    line-height: var(--lh-tight);
    margin: 0;
    min-width: 0;

    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    overflow-wrap: anywhere;
    &::after {
      content: '';
      position: absolute;
      left: -3%;
      right: -3%;
      bottom: -0.1em;
      height: 0.45em;
      background-color: var(--text-primary);
      -webkit-mask-image: var(--underline);
      mask-image: var(--underline);
      -webkit-mask-size: 100% 100%;
      mask-size: 100% 100%;
      -webkit-mask-repeat: no-repeat;
      mask-repeat: no-repeat;
      pointer-events: none;
      opacity: 0;
      transition: opacity var(--t-fast);
    }
  }

  .episodes {
    font-size: var(--fs-xs);
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
    font-weight: var(--fw-medium);
  }

  .anime-card-featured {
    background: transparent;
  }

  .anime-card-featured:hover {
    background: transparent;
  }

  .anime-card-featured .info {
    padding: var(--s-3) 0 0;
  }
</style>